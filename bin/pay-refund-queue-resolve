#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Close a refund-queue entry after a human dealt with it. Operator tool: run on the server with the platform's DIRECT database
 * credentials (the bootstrap file), never through the gateway's /call.
 *
 *   pay-refund-queue-resolve --bootstrap=/path/to/operator.php --id=12 --status=refunded --actor=asha --note="refunded in dashboard"
 *
 * --status is one of refunded | applied_manually | dismissed. --actor and --note are required and are written to the audit
 * trail; the action is also logged to stderr. The bootstrap file RETURNS a configured
 * StoneScriptPay\Http\Operator\RefundQueueResolver.
 */

use StoneScriptPay\Http\Operator\RefundQueueResolver;

$o = getopt('', ['bootstrap:', 'id:', 'status:', 'actor:', 'note:']);
foreach (['bootstrap', 'id', 'status', 'actor', 'note'] as $k) {
    if (!isset($o[$k]) || !is_string($o[$k]) || trim($o[$k]) === '') {
        fwrite(STDERR, "usage: pay-refund-queue-resolve --bootstrap=FILE --id=N --status=refunded|applied_manually|dismissed --actor=NAME --note=TEXT (missing --{$k})\n");
        exit(1);
    }
}
if (!is_file($o['bootstrap']) || !ctype_digit($o['id'])) {
    fwrite(STDERR, "bootstrap file not found or --id is not a number\n");
    exit(1);
}
$job = require $o['bootstrap'];
if (!$job instanceof RefundQueueResolver) {
    fwrite(STDERR, 'the bootstrap file must return a ' . RefundQueueResolver::class . "\n");
    exit(1);
}
fwrite(STDERR, sprintf("[pay-refund-queue-resolve] actor=%s id=%s status=%s\n", $o['actor'], $o['id'], $o['status']));
echo 'entry ' . $o['id'] . ' is now ' . $job->resolve((int) $o['id'], $o['status'], $o['actor'], $o['note']) . "\n";
exit(0);
