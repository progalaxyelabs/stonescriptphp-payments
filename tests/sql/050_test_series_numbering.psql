SELECT pg_temp.t_expect($$TRUNCATE inv_invoice_lines$$, 'PY019', 'lines cannot be truncated');
SELECT pg_temp.t_expect($$TRUNCATE inv_payments$$, 'PY019', 'payments cannot be truncated');

\echo '======== review fixes: draft edge re-validates the basis ========'
SELECT _inv_issuer_upsert('edge-iss', :platform, NULL, 'Edge Pvt Ltd', 'regular', '29AAACX1234C1ZP', '29', 'x', false, 'tester');
SELECT _inv_series_create('edge-inv', 'edge-iss', 'invoice', 'live', 'ED', '/', 5, true, 'tester');
SELECT pg_temp.t_issue('edge-inv', 'live', now(), 'draft') AS ed1 \gset
SELECT _inv_issuer_upsert('edge-iss', :platform, NULL, 'Edge Pvt Ltd', 'composition', '29AAACX1234C1ZP', '29', 'x', false, 'tester');
SELECT pg_temp.t_expect(format('SELECT inv_transition_invoice_status(%s, ''00000000-0000-0000-0000-0000000a0001'', ''l71platform'', ''issued'', ''t'', now())', :ed1),
    'PY015', 'a draft is not numbered after the seller registration changed under it');
SELECT pg_temp.t_assert(pg_temp.t_last('edge-inv', :'cur_fy') = 0, 'and burned no serial');
SELECT _inv_issuer_upsert('edge-iss', :platform, NULL, 'Edge Pvt Ltd', 'regular', '29AAACX1234C1ZP', '29', 'x', false, 'tester');
SELECT pg_temp.t_assert((SELECT inv_transition_invoice_status(:ed1, '00000000-0000-0000-0000-0000000a0001', 'l71platform', 'issued', 't', now())) = 'issued', 'unchanged basis: the draft issues');
SELECT pg_temp.t_issue('edge-inv', 'live', now(), 'draft') AS ed2 \gset
DELETE FROM inv_gst_rate_slabs WHERE rate = 0.18;
SELECT pg_temp.t_expect(format('SELECT inv_transition_invoice_status(%s, ''00000000-0000-0000-0000-0000000a0001'', ''l71platform'', ''issued'', ''t'', now())', :ed2),
    'PY015', 'a draft whose GST rate is no longer an allowed slab is not numbered');
INSERT INTO inv_gst_rate_slabs (rate) VALUES (0.18);

\echo '======== review fixes: schema-behind error is clear ========'
BEGIN;
ALTER TABLE inv_invoices DROP COLUMN buyer_state_code;
SELECT pg_temp.t_expect($$SELECT pg_temp.t_issue('acme-inv', 'live', now())$$, 'PY040', 'issuing against a database without the upgrade raises the clear PY040');
ROLLBACK;

\echo 'ALL L7.1 SQL ASSERTIONS PASSED'
