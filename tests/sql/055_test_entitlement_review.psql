\echo '======== caller-supplied moments are bounded to the database clock ========'
SELECT pg_temp.t_expect(format($f$SELECT * FROM _ent_comp_activate(%L, 'l74rev', 'default', 'p', 5, 'c-future', 'a', 'r', now() + interval '1 hour')$f$, pg_temp.tid(1)), 'PY064', 'a comp dated an hour ahead is refused');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _ent_comp_activate(%L, 'l74rev', 'default', 'p', 5, 'c-past', 'a', 'r', now() - interval '1 hour')$f$, pg_temp.tid(1)), 'PY064', 'a comp dated an hour ago is refused');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' FROM _ent_comp_activate(pg_temp.tid(1), :platform, 'default', 'p', 5, 'c-now', 'a', 'r', now() - interval '2 minutes')), 'within the skew it is accepted');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' FROM _ent_comp_activate(pg_temp.tid(2), :platform, 'default', 'p', 5, 'c-default', 'a', 'r')), 'the default is the database clock');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _ent_set_status(%L, 'l74rev', 'default', 'suspended', 's-future', 'a', 'r', now() + interval '1 day')$f$, pg_temp.tid(2)), 'PY064', 'a status change dated a day ahead is refused');
SELECT pg_temp.t_expect(format($f$SELECT * FROM ent_start_trial(%L, 'l74rev', 'default', now() + interval '1 day', 't-future', 'a')$f$, pg_temp.tid(3)), 'PY064', 'a trial start dated a day ahead is refused');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _ent_enroll_postpaid(%L, 'l74rev', 'default', 9502, pg_temp.profile('rev-inv'), now() + interval '2 days', 'e-future', 'a')$f$, pg_temp.tid(4)), 'PY064', 'a billing anchor in the future is refused');

\echo '======== a late apply never costs the customer paid time ========'
SELECT o_order_ref AS lo1 FROM pay_order_create(pg_temp.tid(10), :platform, 'late-1', 'subscription_period', '9501', NULL, 58882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('499.00'), 'tester') \gset
SELECT o_outcome AS lc1 FROM pay_apply_capture('razorpay', 'pay_late1', :'lo1', pg_temp.tid(10), :platform, 58882, 'INR', 'live', now() - interval '3 days', 'test') \gset
SELECT pg_temp.t_assert(:'lc1' = 'applied' AND (SELECT abs(extract(epoch FROM current_period_end - (((now() AT TIME ZONE 'Asia/Kolkata') + interval '1 month') AT TIME ZONE 'Asia/Kolkata'))) < 60
                                                FROM ent_entitlements WHERE tenant_id = pg_temp.tid(10)),
    'captured 3 days ago but applied now (beyond the 24 h grace): the month is counted from the apply time, not lost to the delay');
SELECT o_order_ref AS lo2 FROM pay_order_create(pg_temp.tid(11), :platform, 'late-2', 'subscription_period', '9501', NULL, 58882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('499.00'), 'tester') \gset
SELECT now() - interval '2 hours' AS cap2_at \gset
SELECT o_outcome AS lc2 FROM pay_apply_capture('razorpay', 'pay_late2', :'lo2', pg_temp.tid(11), :platform, 58882, 'INR', 'live', :'cap2_at', 'test') \gset
SELECT pg_temp.t_assert((SELECT current_period_end = ((:'cap2_at'::timestamptz AT TIME ZONE 'Asia/Kolkata') + interval '1 month') AT TIME ZONE 'Asia/Kolkata' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(11)),
    'applied 2 hours after capture (inside the grace): anchored at the capture time');
-- renewing early still stacks on the previous end
SELECT o_order_ref AS lo3 FROM pay_order_create(pg_temp.tid(11), :platform, 'late-3', 'subscription_period', '9501', NULL, 58882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('499.00'), 'tester') \gset
SELECT o_outcome FROM pay_apply_capture('razorpay', 'pay_late3', :'lo3', pg_temp.tid(11), :platform, 58882, 'INR', 'live', now() - interval '1 hour', 'test') \gset
SELECT pg_temp.t_assert((SELECT current_period_end = ((:'cap2_at'::timestamptz AT TIME ZONE 'Asia/Kolkata') + interval '2 months') AT TIME ZONE 'Asia/Kolkata' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(11)),
    'and a renewal before expiry stacks onto the previous end');

\echo '======== a payment for a suspended entitlement goes to a human ========'
SELECT * FROM _ent_set_status(pg_temp.tid(10), :platform, 'default', 'suspended', 'susp-rev', 'admin:asha', 'chargeback on the first payment') \gset
SELECT count(*) AS inv_before FROM inv_invoices \gset
SELECT o_order_ref AS so1 FROM pay_order_create(pg_temp.tid(10), :platform, 'susp-pay', 'subscription_period', '9501', NULL, 58882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('499.00'), 'tester') \gset
SELECT pg_temp.t_assert((SELECT o_outcome = 'refund_required' AND o_detail LIKE 'paid_while_suspended:%' FROM pay_apply_capture('razorpay', 'pay_susp1', :'so1', pg_temp.tid(10), :platform, 58882, 'INR', 'live', now(), 'test')),
    'the capture is refund_required: paid_while_suspended');
SELECT pg_temp.t_assert((SELECT count(*) = 1 FROM pay_refund_queue WHERE gateway_txn_ref = 'pay_susp1' AND reason = 'paid_while_suspended' AND status = 'open')
                    AND (SELECT count(*) = :inv_before FROM inv_invoices) AND (SELECT status = 'suspended' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(10)),
    'it is queued (alerted by the existing refund queue), no invoice was issued, the suspension stands');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' FROM _ent_comp_activate(pg_temp.tid(10), :platform, 'default', 'goodwill', 3, 'comp-susp', 'admin:asha', 'goodwill')) AND
                        (SELECT status = 'suspended' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(10)), 'a comp is recorded for a suspended entitlement but does not lift the suspension');

\echo '======== postpaid and prepaid are not mixed ========'
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(20), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '40 days', 'enr-20', 'admin:asha') \gset
SELECT pg_temp.t_expect(format($f$SELECT * FROM pay_order_create(%L, 'l74rev', 'pp-1', 'subscription_period', '9501', NULL, 58882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('499.00'), 'tester')$f$, pg_temp.tid(20)),
    'PY061', 'a postpaid tenant cannot buy a subscription_period order');
SELECT pg_temp.t_expect(format($f$SELECT * FROM pay_order_create(%L, 'l74rev', 'pp-2', 'one_time_license', '9503', NULL, 235882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('1999.00'), 'tester')$f$, pg_temp.tid(20)),
    'PY061', 'nor a one_time_license order');
SELECT count(*) AS billed FROM pg_temp.bill(now()) WHERE o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(20)) AND o_error IS NULL \gset
SELECT pg_temp.t_assert(:billed = 1, 'its first period (anchor 40 days ago) was invoiced');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _ent_set_billing_mode(%L, 'l74rev', 'default', 'prepaid', NULL, NULL, NULL, now() + interval '30 days', 'mode-20', 'admin:asha', 'x')$f$, pg_temp.tid(20)),
    'PY061', 'switching to prepaid is refused while an invoice is unpaid');
SELECT i.id AS unpaid_inv FROM inv_invoices i WHERE i.tenant_id = pg_temp.tid(20) AND i.status = 'due' \gset
SELECT inv_record_payment(:unpaid_inv, pg_temp.tid(20), :platform, 'razorpay', 'pay_pp20', 58882, 'INR', 'success', now(), 'test');
SELECT (now() + interval '30 days') AS pe20 \gset
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' AND o_billing_mode = 'prepaid' FROM _ent_set_billing_mode(pg_temp.tid(20), :platform, 'default', 'prepaid', NULL, NULL, NULL, :'pe20'::timestamptz, 'mode-20', 'admin:asha', 'customer moved to annual')),
    'once settled the operator switches it to prepaid (audited)');
SELECT pg_temp.t_assert((SELECT o_outcome = 'already_applied' FROM _ent_set_billing_mode(pg_temp.tid(20), :platform, 'default', 'prepaid', NULL, NULL, NULL, :'pe20'::timestamptz, 'mode-20', 'admin:asha', 'customer moved to annual')), 'idempotent per key');
SELECT pg_temp.t_assert((SELECT billing_mode = 'prepaid' AND billing_profile IS NULL AND next_billing_at IS NULL FROM ent_entitlements WHERE tenant_id = pg_temp.tid(20))
                    AND (SELECT count(*) = 1 FROM ent_activations WHERE tenant_id = pg_temp.tid(20) AND kind = 'mode'), 'now prepaid, one audit row');
SELECT o_order_ref AS pp3 FROM pay_order_create(pg_temp.tid(20), :platform, 'pp-3', 'subscription_period', '9501', NULL, 58882, 'INR', 'razorpay', 'live', 'rev-ord', pg_temp.spec('499.00'), 'tester') \gset
SELECT pg_temp.t_assert(:'pp3' LIKE 'ord\_%', 'and a prepaid order is accepted for it');

-- simulated future dates in the sections below: the clamp (a future --as-of means nothing) is exercised separately at the end
UPDATE pay_config SET config_value = '4000000000' WHERE config_key = 'pay_clock_skew_seconds';
\echo '======== billing periods are anchor + n x interval in the billing zone, never chained, whatever the session zone ========'
SET timezone = 'America/Los_Angeles';
SELECT pg_temp.t_assert(_ent_period_at('2026-01-31 10:00+05:30', 1, interval '1 month') = '2026-02-28 10:00+05:30'::timestamptz
                    AND _ent_period_at('2026-01-31 10:00+05:30', 2, interval '1 month') = '2026-03-31 10:00+05:30'::timestamptz, 'a 31 January anchor: 28 Feb, then 31 Mar (not 28 Mar), under a Los Angeles session');
SELECT pg_temp.t_assert(_ent_period_at('2026-01-31 01:00+05:30', 1, interval '1 month') = '2026-02-28 01:00+05:30'::timestamptz,
    'the day is the IST day (01:00 IST is still 30 January in Los Angeles and UTC)');
SELECT pg_temp.t_assert(_ent_period_at('2028-01-31 10:00+05:30', 1, interval '1 month') = '2028-02-29 10:00+05:30'::timestamptz
                    AND _ent_period_at('2028-02-29 10:00+05:30', 12, interval '1 month') = '2029-02-28 10:00+05:30'::timestamptz
                    AND _ent_period_at('2028-02-29 10:00+05:30', 48, interval '1 month') = '2032-02-29 10:00+05:30'::timestamptz, 'a leap year: 29 Feb 2028, 28 Feb 2029, 29 Feb 2032');
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(30), :platform, 'default', 9502, pg_temp.profile('rev-inv'), '2026-01-31 10:00+05:30', 'enr-30', 'admin:asha') \gset
SELECT array_agg(to_char(o_period_end AT TIME ZONE 'Asia/Kolkata', 'YYYY-MM-DD HH24:MI') ORDER BY o_period_end) AS ends FROM pg_temp.bill('2027-03-01 00:00+05:30') WHERE o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(30)) \gset
RESET timezone;
SELECT pg_temp.t_assert(:'ends' = '{"2026-02-28 10:00","2026-03-31 10:00","2026-04-30 10:00","2026-05-31 10:00","2026-06-30 10:00","2026-07-31 10:00","2026-08-31 10:00","2026-09-30 10:00","2026-10-31 10:00","2026-11-30 10:00","2026-12-31 10:00","2027-01-31 10:00"}',
    'twelve periods from a 31 January anchor end on the last day of each month and return to the 31st');
SELECT pg_temp.t_assert((SELECT count(*) = 12 AND bool_and(period_start = lag_end OR lag_end IS NULL) FROM (SELECT period_start, lag(period_end) OVER (ORDER BY period_start) lag_end FROM ent_billing_runs r JOIN ent_entitlements e ON e.id = r.entitlement_id WHERE e.tenant_id = pg_temp.tid(30)) x),
    'periods are contiguous: each starts exactly where the previous ended');
SELECT pg_temp.t_assert((SELECT to_char(next_billing_at AT TIME ZONE 'Asia/Kolkata', 'YYYY-MM-DD HH24:MI') = '2027-02-28 10:00' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(30)), 'the 13th period would be billed from 28 Feb 2027, again computed from the anchor');
SELECT pg_temp.t_assert((SELECT count(*) = 1 AND max(to_char(o_period_end AT TIME ZONE 'Asia/Kolkata', 'YYYY-MM-DD')) = '2027-02-28' FROM pg_temp.bill('2027-03-01 00:00+05:30') WHERE o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(30))),
    'the next run bills the 13th (catch-up is bounded to 12 per run)');
-- prepaid stacking is in the billing zone too
SET timezone = 'America/Los_Angeles';
SELECT pg_temp.t_assert((SELECT o_period_to = '2026-02-28 01:00+05:30'::timestamptz FROM _ent_apply_period(pg_temp.tid(31), :platform, 'default', 'comp', 'x', NULL, interval '1 month', 'active', 'comp', '2026-01-31 01:00+05:30', 'zone-1', 'h', 'a', 'r', NULL, NULL)),
    'a prepaid month from 31 Jan 01:00 IST ends 28 Feb 01:00 IST under a Los Angeles session');
RESET timezone;

UPDATE pay_config SET config_value = '4000000000' WHERE config_key = 'pay_clock_skew_seconds';
\echo '======== the tick reaches every row ========'
SELECT count(*) AS seeded FROM (SELECT _ent_comp_activate(pg_temp.tid(100 + g), :platform, 'default', 'short', 1, 'tick-' || g, 'a', 'r', now() - interval '1 minute') FROM generate_series(1, 25) g) x \gset
SELECT * FROM _ent_tick(now() + interval '3 days', 4, 0) \gset first_
SELECT pg_temp.t_assert(:first_o_examined = 4 AND :first_o_last_id > 0, 'a batch examines at most its limit and reports the cursor');
CREATE TEMP TABLE tick_log (examined INT, changed INT);
DO $t$
DECLARE v RECORD; v_after BIGINT := 0;
BEGIN
    LOOP
        SELECT * INTO v FROM _ent_tick(now() + interval '3 days', 4, v_after);
        EXIT WHEN v.o_examined = 0;
        INSERT INTO tick_log VALUES (v.o_examined, v.o_changed); v_after := v.o_last_id;
    END LOOP;
END $t$;
SELECT pg_temp.t_assert((SELECT count(*) > 6 FROM tick_log), 'the runner keeps going until a batch is empty (many batches)');
SELECT pg_temp.t_assert((SELECT count(*) = 25 FROM ent_entitlements WHERE tenant_id >= pg_temp.tid(101) AND tenant_id <= pg_temp.tid(125) AND status = 'read_only'),
    'all 25 expired entitlements were reached and persisted, not just the first batch');

UPDATE pay_config SET config_value = '300' WHERE config_key = 'pay_clock_skew_seconds';
\echo '======== a failing postpaid entitlement backs off and does not starve the others ========'
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(40), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '40 days', 'enr-40', 'admin:asha') \gset
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(41), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '40 days', 'enr-41', 'admin:asha') \gset
UPDATE ent_entitlements SET billing_profile = jsonb_set(billing_profile, '{series_code}', '"gone-series"') WHERE tenant_id = pg_temp.tid(40);
SELECT count(*) FILTER (WHERE o_error IS NOT NULL) AS bad, count(*) FILTER (WHERE o_error IS NULL AND o_invoice_id IS NOT NULL) AS good FROM pg_temp.bill(now()) WHERE o_entitlement_id IN (SELECT id FROM ent_entitlements WHERE tenant_id IN (pg_temp.tid(40), pg_temp.tid(41))) \gset
SELECT pg_temp.t_assert(:bad = 1 AND :good = 1, 'the broken entitlement fails and the healthy one is still invoiced in the same run');
SELECT pg_temp.t_assert((SELECT billing_failures = 1 AND billing_last_error LIKE '%PY010%' OR billing_last_error LIKE '%gone-series%' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(40)), 'the failure is recorded on the entitlement');
SELECT pg_temp.t_assert((SELECT o_error LIKE 'ENT_BILLING_FAILED%' FROM _ent_billing_run_one((SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(40)), now(), 'billing-run')), 'the error carries the stable token the runner alerts on');
SELECT pg_temp.t_assert((SELECT billing_failures = 2 AND billing_retry_at > now() + interval '590 seconds' AND billing_retry_at < now() + interval '610 seconds' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(40)),
    'the second failure doubles the delay (300 s -> 600 s)');
SELECT pg_temp.t_assert(NOT EXISTS (SELECT 1 FROM _ent_billing_due(now(), 100) d WHERE d.o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(40))), 'while backed off it is not offered again');
UPDATE ent_entitlements SET billing_retry_at = now() - interval '1 second', billing_profile = jsonb_set(billing_profile, '{series_code}', '"rev-inv"') WHERE tenant_id = pg_temp.tid(40);
SELECT pg_temp.t_assert((SELECT o_invoice_id IS NOT NULL FROM _ent_billing_run_one((SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(40)), now(), 'billing-run')), 'once fixed and the delay has passed it is invoiced');
SELECT pg_temp.t_assert((SELECT billing_failures = 0 AND billing_retry_at IS NULL AND billing_last_error IS NULL FROM ent_entitlements WHERE tenant_id = pg_temp.tid(40)), 'and the failure state is cleared');

\echo '======== per-platform missing mode ========'
SELECT pg_temp.t_assert((SELECT o_read_only FROM ent_get(pg_temp.tid(900), 'platform-a')) AND (SELECT o_read_only FROM ent_get(pg_temp.tid(900), 'platform-b')), 'by default a tenant with no row is read-only everywhere');
SELECT _ent_set_missing_mode('platform-b', 'allow', 'admin:asha');
SELECT pg_temp.t_assert((SELECT o_read_only FROM ent_get(pg_temp.tid(900), 'platform-a')) AND NOT (SELECT o_read_only FROM ent_get(pg_temp.tid(900), 'platform-b')), 'a per-platform row changes only that platform');
SELECT pg_temp.t_expect($$SELECT _ent_set_missing_mode('platform-b', 'bogus', 'admin:asha')$$, 'PY060', 'only read_only | allow');

\echo '======== the cutover gate and the delta import ========'
CREATE TABLE legacy_cut (id SERIAL PRIMARY KEY, platform_code VARCHAR(50) NOT NULL, tenant_id TEXT NOT NULL, plan_code VARCHAR(50) NOT NULL DEFAULT 'annual',
    status VARCHAR(50) NOT NULL, started_at TIMESTAMPTZ NOT NULL, expires_at TIMESTAMPTZ, cancelled_at TIMESTAMPTZ);
INSERT INTO legacy_cut (platform_code, tenant_id, status, started_at, expires_at, cancelled_at) VALUES
    ('l74cut', pg_temp.tid(201)::text, 'active',    '2026-01-01', '2027-06-01', NULL),
    ('l74cut', pg_temp.tid(202)::text, 'active',    '2025-01-01', '2026-01-01', NULL),
    ('l74cut', pg_temp.tid(203)::text, 'cancelled', '2026-01-01', NULL, '2026-03-01'),
    ('l74cut', pg_temp.tid(204)::text, 'trial',     now() - interval '1 day', now() + interval '5 days', NULL),
    ('l74cut', 'not-a-uuid', 'active', '2026-01-01', '2027-01-01', NULL);
SELECT * FROM _ent_import_legacy('legacy_cut', 'migration-script') \gset imp_
SELECT pg_temp.t_assert(:imp_o_imported = 4 AND :imp_o_invalid = 1, 'four imported, the non-UUID tenant counted invalid');
SELECT pg_temp.t_assert((SELECT status = 'ended' AND current_period_end = '2026-03-01' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(203))
                    AND (SELECT o_read_only FROM ent_get(pg_temp.tid(203), 'l74cut')), 'a cancelled legacy row with NULL expires_at is expired AT the cancellation time, not active forever');
SELECT pg_temp.t_expect($$SELECT _ent_cutover_check('legacy_cut', 'l74cut', 'read_only')$$, 'PY067', 'the gate is closed while a legacy row is invalid');
DELETE FROM legacy_cut WHERE tenant_id = 'not-a-uuid';
SELECT pg_temp.t_assert(_ent_cutover_check('legacy_cut', 'l74cut', 'read_only') LIKE 'ok:%', 'with no invalid row, no difference and the same missing mode the gate opens');
SELECT pg_temp.t_expect($$SELECT _ent_cutover_check('legacy_cut', 'l74cut', 'allow')$$, 'PY067', 'but not when the legacy platform allowed missing subscriptions and the library would not');
SELECT _ent_set_missing_mode('l74cut', 'allow', 'admin:asha');
SELECT pg_temp.t_assert(_ent_cutover_check('legacy_cut', 'l74cut', 'allow') LIKE 'ok:%', 'once the platform''s mode matches the legacy one it opens');
-- the legacy writer kept writing after the first import (a renewal)
UPDATE legacy_cut SET expires_at = '2028-01-01' WHERE tenant_id = pg_temp.tid(202)::text;
SELECT pg_temp.t_expect($$SELECT _ent_cutover_check('legacy_cut', 'l74cut', 'allow')$$, 'PY067', 'a legacy renewal written after the import closes the gate again');
SELECT pg_temp.t_assert((SELECT o_imported = 0 AND o_already = 4 AND o_synced = 0 FROM _ent_import_legacy('legacy_cut', 'migration-script')), 'a plain re-import does not carry the renewal');
SELECT _ent_comp_activate(pg_temp.tid(201), 'l74cut', 'default', 'goodwill', 5, 'cut-comp', 'admin:asha', 'goodwill');
UPDATE legacy_cut SET expires_at = '2028-06-01' WHERE tenant_id = pg_temp.tid(201)::text;
SELECT * FROM _ent_import_legacy('legacy_cut', 'migration-script', now(), TRUE) \gset sync_
SELECT pg_temp.t_assert(:sync_o_synced = 1 AND :sync_o_skipped_newer = 1, 'the delta import carries the renewal (1) and leaves the entitlement that moved on in ent_* alone (1)');
UPDATE legacy_cut SET expires_at = (SELECT current_period_end FROM ent_entitlements WHERE tenant_id = pg_temp.tid(201)) WHERE tenant_id = pg_temp.tid(201)::text;
SELECT pg_temp.t_assert(_ent_cutover_check('legacy_cut', 'l74cut', 'allow') LIKE 'ok:%', 'after the delta import the gate opens again');

\echo '======== W2: a poison row records its failure and never stalls the run ========'
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(42), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '40 days', 'enr-42', 'admin:asha') \gset
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(43), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '40 days', 'enr-43', 'admin:asha') \gset
UPDATE ent_entitlements SET subscription_pricing_plan_id = NULL WHERE tenant_id = pg_temp.tid(42);
SELECT count(*) FILTER (WHERE o_error IS NOT NULL) AS bad2, count(*) FILTER (WHERE o_invoice_id IS NOT NULL) AS good2 FROM pg_temp.bill(now()) WHERE o_entitlement_id IN (SELECT id FROM ent_entitlements WHERE tenant_id IN (pg_temp.tid(42), pg_temp.tid(43))) \gset
SELECT pg_temp.t_assert(:bad2 = 1 AND :good2 = 1, 'a row with no plan (a failure in the SETUP, outside the per-period block) fails alone; its neighbour is still invoiced');
SELECT pg_temp.t_assert((SELECT billing_failures = 1 AND billing_retry_at > now() AND billing_last_error LIKE '%no postpaid plan%' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(42)), 'and the poison row recorded its backoff');

\echo '======== W3: postpaid -> prepaid -> postpaid does not skip periods ========'
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(50), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '70 days', 'enr-50', 'admin:asha') \gset
SELECT count(*) AS first_stint FROM pg_temp.bill(now()) WHERE o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(50)) AND o_invoice_id IS NOT NULL \gset
SELECT pg_temp.t_assert(:first_stint = 2, 'the first postpaid stint billed two periods');
SELECT inv_record_payment(i.id, pg_temp.tid(50), :platform, 'razorpay', 'pay_w3_' || i.id, 58882, 'INR', 'success', now(), 'test') FROM inv_invoices i WHERE i.tenant_id = pg_temp.tid(50) AND i.status = 'due';
SELECT (now() + interval '10 days') AS pe50 \gset
SELECT o_outcome FROM _ent_set_billing_mode(pg_temp.tid(50), :platform, 'default', 'prepaid', NULL, NULL, NULL, :'pe50'::timestamptz, 'mode-50a', 'admin:asha', 'annual prepay') \gset
SELECT (now() - interval '35 days') AS anchor50 \gset
SELECT o_outcome FROM _ent_set_billing_mode(pg_temp.tid(50), :platform, 'default', 'postpaid', 9502, pg_temp.profile('rev-inv'), :'anchor50'::timestamptz, NULL, 'mode-50b', 'admin:asha', 'back to monthly') \gset
SELECT array_agg(o_period_start ORDER BY o_period_start) AS re_starts FROM pg_temp.bill(now()) WHERE o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(50)) AND o_invoice_id IS NOT NULL \gset
SELECT pg_temp.t_assert(:'re_starts'::timestamptz[] = ARRAY[:'anchor50'::timestamptz], 'after the re-switch the FIRST period is billed from the new anchor (the old stint''s runs are not counted)');

\echo '======== W4: a future --as-of is clamped ========'
UPDATE pay_config SET config_value = '300' WHERE config_key = 'pay_clock_skew_seconds';
SELECT o_outcome FROM _ent_enroll_postpaid(pg_temp.tid(60), :platform, 'default', 9502, pg_temp.profile('rev-inv'), now() - interval '10 days', 'enr-60', 'admin:asha') \gset
SELECT pg_temp.t_assert(NOT EXISTS (SELECT 1 FROM _ent_billing_due(now() + interval '60 days', 100) d WHERE d.o_entitlement_id = (SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(60))), 'a billing run dated 60 days ahead finds nothing that is not due now');
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _ent_billing_run_one((SELECT id FROM ent_entitlements WHERE tenant_id = pg_temp.tid(60)), now() + interval '60 days', 'billing-run')), 'and billing it is a no-op');
SELECT _ent_comp_activate(pg_temp.tid(61), :platform, 'default', 'short', 1, 'tick-clamp', 'a', 'r');
SELECT pg_temp.t_assert((SELECT o_changed = 0 FROM _ent_tick(now() + interval '30 days', 100000, (SELECT id - 1 FROM ent_entitlements WHERE tenant_id = pg_temp.tid(61))) WHERE o_examined >= 1), 'a tick dated 30 days ahead does not persist a read_only that is not true yet');

\echo '======== C1: an explicit NULL time means now; W5: sync compares the CURRENT row ========'
CREATE TABLE legacy_cut2 (id SERIAL PRIMARY KEY, platform_code VARCHAR(50) NOT NULL, tenant_id TEXT NOT NULL, plan_code VARCHAR(50) NOT NULL DEFAULT 'annual',
    status VARCHAR(50) NOT NULL, started_at TIMESTAMPTZ NOT NULL, expires_at TIMESTAMPTZ, cancelled_at TIMESTAMPTZ);
INSERT INTO legacy_cut2 (platform_code, tenant_id, status, started_at, expires_at) VALUES ('l74cut2', pg_temp.tid(301)::text, 'cancelled', now() - interval '30 days', now() + interval '20 days');
SELECT pg_temp.t_assert((SELECT o_imported = 1 FROM _ent_import_legacy('legacy_cut2', 'migration-script', NULL)), 'an import called with an explicit NULL time works (NULL means now)');
SELECT pg_temp.t_assert((SELECT status = 'active' FROM ent_entitlements WHERE tenant_id = pg_temp.tid(301)), 'and a cancelled row with time left is active until then (not ended by a NULL comparison)');
SELECT current_period_end AS e1 FROM ent_entitlements WHERE tenant_id = pg_temp.tid(301) \gset
UPDATE legacy_cut2 SET expires_at = now() + interval '80 days' WHERE tenant_id = pg_temp.tid(301)::text;
SELECT pg_temp.t_assert((SELECT o_synced = 1 FROM _ent_import_legacy('legacy_cut2', 'migration-script', NULL, TRUE)), 'sync carries the legacy change');
UPDATE legacy_cut2 SET expires_at = :'e1'::timestamptz WHERE tenant_id = pg_temp.tid(301)::text;
SELECT pg_temp.t_assert((SELECT o_synced = 1 FROM _ent_import_legacy('legacy_cut2', 'migration-script', NULL, TRUE)), 'and a change REVERTED to an earlier value is synced back too (compared to the current entitlement, not a remembered hash)');
SELECT pg_temp.t_assert((SELECT current_period_end = :'e1'::timestamptz FROM ent_entitlements WHERE tenant_id = pg_temp.tid(301)), 'the entitlement equals the legacy row again');
SELECT pg_temp.t_assert((SELECT o_synced = 0 AND o_already = 1 FROM _ent_import_legacy('legacy_cut2', 'migration-script', NULL, TRUE)), 'and a sync with nothing changed changes nothing');

\echo 'ALL L7.4 REVIEW ASSERTIONS PASSED'
