-- stonescriptphp-payments :: TEST - entitlement review fixes (L7.4): clock bounds, late apply, suspended payment, postpaid <-> prepaid,
-- billing-zone date math, tick batching, billing failure backoff, the cutover gate. STRICT (sets ON_ERROR_STOP itself).
-- Runs with the PRODUCTION clock settings (skew 300 s, late-apply grace 24 h) except where a section says otherwise.
\set ON_ERROR_STOP on
UPDATE pay_config SET config_value = '300' WHERE config_key = 'pay_clock_skew_seconds';
UPDATE pay_config SET config_value = '24' WHERE config_key = 'ent_late_apply_grace_hours';
UPDATE inv_gst_config SET config_value = '36500' WHERE config_key IN ('issue_date_window_days_live', 'issue_date_window_days_test');
\set platform '''l74rev'''

CREATE FUNCTION pg_temp.t_assert(p_ok BOOLEAN, p_label TEXT) RETURNS VOID AS $$
BEGIN
    IF p_ok IS NOT TRUE THEN RAISE EXCEPTION 'ASSERTION FAILED: %', p_label; END IF;
    RAISE NOTICE 'ok: %', p_label;
END; $$ LANGUAGE plpgsql;
CREATE FUNCTION pg_temp.t_expect(p_sql TEXT, p_state TEXT, p_label TEXT) RETURNS VOID AS $$
BEGIN
    BEGIN
        EXECUTE p_sql;
    EXCEPTION WHEN OTHERS THEN
        IF SQLSTATE = p_state THEN RAISE NOTICE 'ok: % (raised %)', p_label, p_state; RETURN; END IF;
        RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but got % (%)', p_label, p_state, SQLSTATE, SQLERRM;
    END;
    RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but nothing was raised', p_label, p_state;
END; $$ LANGUAGE plpgsql;
CREATE FUNCTION pg_temp.tid(n INT) RETURNS UUID AS $$ SELECT ('00000000-0000-0000-0000-0000000e' || lpad(n::text, 4, '0'))::uuid; $$ LANGUAGE sql;
CREATE FUNCTION pg_temp.spec(p_price TEXT) RETURNS TEXT AS $$
    SELECT jsonb_build_object(
        'buyer', jsonb_build_object('legal_name', 'Buyer One', 'registration_status', 'unregistered', 'address_state', 'Karnataka'),
        'billing_country_code', 'IN', 'billing_state', 'Karnataka', 'supply_type', 'domestic', 'price_is_inclusive', false, 'round_off', false, 'due_days', 0,
        'lines', jsonb_build_array(jsonb_build_object('description', 'Plan', 'hsn_sac', '998314', 'quantity', '1', 'unit_price', p_price, 'gst_rate', 0.18)))::text;
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.profile(p_series TEXT) RETURNS JSONB AS $$
    SELECT jsonb_build_object('series_code', p_series, 'mode', 'live', 'billing_country_code', 'IN', 'billing_state', 'Karnataka', 'hsn_sac', '998314', 'gst_rate', 0.18,
        'buyer', jsonb_build_object('legal_name', 'Post Buyer', 'registration_status', 'unregistered', 'address_state', 'Karnataka'));
$$ LANGUAGE sql;
CREATE FUNCTION pg_temp.bill(p_as_of TIMESTAMPTZ) RETURNS TABLE (o_entitlement_id BIGINT, o_period_start TIMESTAMPTZ, o_period_end TIMESTAMPTZ, o_invoice_id BIGINT, o_error TEXT) AS $$
DECLARE v_id BIGINT;
BEGIN
    FOR v_id IN SELECT d.o_entitlement_id FROM _ent_billing_due(p_as_of, 100000) d LOOP
        RETURN QUERY SELECT v_id, r.o_period_start, r.o_period_end, r.o_invoice_id, r.o_error FROM _ent_billing_run_one(v_id, p_as_of, 'billing-run') r;
    END LOOP;
END; $$ LANGUAGE plpgsql;

