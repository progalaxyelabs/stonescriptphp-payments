-- stonescriptphp-pay :: switching cadence mid-cycle, prorated, both directions
-- Frank: Monthly (₹399) -> Annual (₹3,839) mid-cycle -> back to Monthly mid-year.
\set frank_tenant '''00000000-0000-0000-0000-000000000006'''
\set platform     '''testplatform'''

INSERT INTO customer_pricing_plans
    (tenant_id, platform_code, pricing_plan_id, subscription_pricing_plan_id, started_at, created_at, created_by)
VALUES
    (:frank_tenant, :platform, 5, 6, '2026-05-01', '2026-05-01', 'seed');  -- Frank starts Monthly @ ₹399 (period 05-01 -> 06-01)

\echo '--- renew_subscription_pricing_plan(frank, 5[Annual], 2026-05-15, ...) — switch 14 days into a 31-day month ---'
\echo '--- expect: old row cancelled at 2026-05-15 (cancel_reason=switched_plan), new row starts immediately, credit computed ---'
SELECT * FROM renew_subscription_pricing_plan(:frank_tenant, :platform, 5, '2026-05-15', 'api');

\echo '--- get_active_pricing_plan(frank, 2026-06-01) — should show the ANNUAL plan (started 05-15, expires 2027-05-15), not the old monthly ---'
SELECT * FROM get_active_pricing_plan(:frank_tenant, :platform, '2026-06-01');

\echo '--- renew_subscription_pricing_plan(frank, 6[Monthly], 2026-08-15, ...) — switch back, 3 whole months into the 12-month annual ---'
\echo '--- expect: annual cancelled at 2026-08-15 (switched_plan), credit = 9/12 of ₹3,839 ---'
SELECT * FROM renew_subscription_pricing_plan(:frank_tenant, :platform, 6, '2026-08-15', 'api');

\echo '--- get_active_pricing_plan(frank, 2026-09-01) — should show the new MONTHLY plan (started 08-15, expires 09-15) ---'
SELECT * FROM get_active_pricing_plan(:frank_tenant, :platform, '2026-09-01');

\echo '--- get_customer_purchase_history(frank, 2026-01-01, 2027-01-01) — full chain: monthly -> switched -> annual -> switched -> monthly ---'
SELECT * FROM get_customer_purchase_history(:frank_tenant, :platform, '2026-01-01', '2027-01-01');
