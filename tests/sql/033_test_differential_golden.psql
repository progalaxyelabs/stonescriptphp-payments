\echo '=== Multi-line export invoices, two distinct SAC codes (beyond PHP oracle) ==='
DO $D$ DECLARE r inv_computed_invoice; BEGIN
  r := inv_compute_invoice(ROW('Example Exports Pvt Ltd','29AAAAA0000A1Z5','seller','regular','Karnataka',NULL)::inv_party_input,ROW('Acme Overseas Inc',NULL,'buyer',NULL,'Outside India',NULL)::inv_party_input,'export_lut',NULL,false,false,'USD','95.7245','19144.90','INV-TEST-011','2026-09-13'::timestamptz,ARRAY[ROW('Managed Web Hosting','998315','1','200.00',0,NULL,false)::inv_line_input]);
  PERFORM inv_assert_eq('INV11.igst', r.lines[1].igst_minor, 0);
  PERFORM inv_assert_eq('INV11.cgst', r.lines[1].cgst_minor, 0);
  PERFORM inv_assert_eq('INV11.sgst', r.lines[1].sgst_minor, 0);
  PERFORM inv_assert_text_eq('INV11.tax_treatment', r.tax_treatment, 'export_lut');
  PERFORM inv_assert_text_eq('INV11.pos_name (Outside India)', r.place_of_supply_name, 'Other Country');
  PERFORM inv_assert_text_eq('INV11.sac_per_line', r.lines[1].hsn_sac, '998315');
END $D$;
SELECT inv_assert_eq('INV11.statutory_inr_paisa (200.00 x 95.7245)', (inv_fx_inr_statutory_value_from_decimal('USD','2026-09-13','200.00')), 1914490);
SELECT inv_assert_text_eq('INV11.statutory_inr_str', (inv_money_to_decimal_string(inv_fx_inr_statutory_value_from_decimal('USD','2026-09-13','200.00'))), '19144.90');
DO $D$ DECLARE r inv_computed_invoice; BEGIN
  r := inv_compute_invoice(ROW('Example Exports Pvt Ltd','29AAAAA0000A1Z5','seller','regular','Karnataka',NULL)::inv_party_input,ROW('Acme Overseas Inc',NULL,'buyer',NULL,'Outside India',NULL)::inv_party_input,'export_lut',NULL,false,false,'USD','95.7245','7179.34','INV-TEST-010','2026-09-13'::timestamptz,ARRAY[ROW('Software Dev Consultation','998313','1','75.00',0,NULL,false)::inv_line_input]);
  PERFORM inv_assert_eq('INV10.igst', r.lines[1].igst_minor, 0);
  PERFORM inv_assert_text_eq('INV10.tax_treatment', r.tax_treatment, 'export_lut');
  PERFORM inv_assert_text_eq('INV10.pos_name (Outside India)', r.place_of_supply_name, 'Other Country');
  PERFORM inv_assert_text_eq('INV10.sac_per_line (distinct SAC)', r.lines[1].hsn_sac, '998313');
END $D$;
SELECT inv_assert_eq('INV10.statutory_inr_paisa (75.00 x 95.7245)', (inv_fx_inr_statutory_value_from_decimal('USD','2026-09-13','75.00')), 717934);
SELECT inv_assert_text_eq('INV10.statutory_inr_str', (inv_money_to_decimal_string(inv_fx_inr_statutory_value_from_decimal('USD','2026-09-13','75.00'))), '7179.34');


\echo '=== ACCEPTED DIVERGENCES FROM THE PHP ORACLE (CGST/SGST remainder rule) ==='
-- The PHP reference rounds CGST and SGST independently (each half-up of half the line's tax), which bills
-- ONE PAISA TOO MUCH whenever a line's total tax is odd. Since L7 the SQL engine rounds the line's TOTAL tax once,
-- gives CGST the half-up half and SGST the remainder, so the heads always sum to the rounded total. The oracle
-- values above are left untouched; exactly these 56 (label, new value) pairs are the intended divergence.
-- A divergence not listed here, or a listed one with a different value, still FAILS the tally.
-- [CA TO CONFIRM: an unequal CGST/SGST split of one paisa is acceptable on a tax invoice.]
CREATE TEMP TABLE _inv_diff_accepted(label text, actual text, oracle text);
