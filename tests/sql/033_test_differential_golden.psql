-- stonescriptphp-invoice :: DIFFERENTIAL golden test.
-- Every expected value here was harvested as the OUTPUT of the reference
-- implementation fed the SAME inputs as the SQL functions. This is the
-- gold-standard differential proof: the pgsql path is proven equivalent by
-- running the golden table through the functions, not by re-asserting hand-copied numbers.
-- ON_ERROR_STOP=0: asserts LOG (never abort) into _inv_diff_results; the final SELECTs tally.

DROP TABLE IF EXISTS _inv_diff_results;
CREATE TABLE _inv_diff_results(id serial PRIMARY KEY, label text, passed boolean, actual text, expected text);

CREATE OR REPLACE FUNCTION inv_assert_eq(p_label text, p_actual bigint, p_expected bigint) RETURNS void AS $$
  INSERT INTO _inv_diff_results(label,passed,actual,expected)
  VALUES(p_label, p_actual IS NOT DISTINCT FROM p_expected, p_actual::text, p_expected::text);
$$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION inv_assert_text_eq(p_label text, p_actual text, p_expected text) RETURNS void AS $$
  INSERT INTO _inv_diff_results(label,passed,actual,expected)
  VALUES(p_label, p_actual IS NOT DISTINCT FROM p_expected, p_actual, p_expected);
$$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION inv_assert_bool(p_label text, p_actual boolean, p_expected boolean) RETURNS void AS $$
  INSERT INTO _inv_diff_results(label,passed,actual,expected)
  VALUES(p_label, p_actual IS NOT DISTINCT FROM p_expected, p_actual::text, p_expected::text);
$$ LANGUAGE sql;

\echo '=== MoneyTest (Lib/Money.php) ==='
