\echo '=== GstStateCodesTest (Support/GstStateCodes.php) ==='
SELECT inv_assert_text_eq('GstStateCodes.resolve(29)', (inv_gst_resolve_state('29')), '29');
SELECT inv_assert_text_eq('GstStateCodes.resolve(27)', (inv_gst_resolve_state('27')), '27');
SELECT inv_assert_text_eq('GstStateCodes.resolve(00)', (inv_gst_resolve_state('00')), NULL);
SELECT inv_assert_text_eq('GstStateCodes.resolve(28)', (inv_gst_resolve_state('28')), NULL);
SELECT inv_assert_text_eq('GstStateCodes.resolve(92)', (inv_gst_resolve_state('92')), NULL);
SELECT inv_assert_text_eq('GstStateCodes.resolve(99)', (inv_gst_resolve_state('99')), NULL);
SELECT inv_assert_text_eq('GstStateCodes.resolve(Maharashtra)', (inv_gst_resolve_state('Maharashtra')), '27');
SELECT inv_assert_text_eq('GstStateCodes.resolve(karnataka)', (inv_gst_resolve_state('karnataka')), '29');
SELECT inv_assert_text_eq('GstStateCodes.resolve(Orissa)', (inv_gst_resolve_state('Orissa')), '21');
SELECT inv_assert_text_eq('GstStateCodes.resolve(Odisha)', (inv_gst_resolve_state('Odisha')), '21');
SELECT inv_assert_text_eq('GstStateCodes.resolve(Not A Real State)', (inv_gst_resolve_state('Not A Real State')), NULL);
SELECT inv_assert_text_eq('GstStateCodes.resolve(<empty>)', (inv_gst_resolve_state('')), NULL);
SELECT inv_assert_text_eq('GstStateCodes.resolve(96)', (inv_gst_resolve_state('96')), '96');
SELECT inv_assert_text_eq('GstStateCodes.resolve(97)', (inv_gst_resolve_state('97')), '97');
SELECT inv_assert_text_eq('GstStateCodes.resolve(null)', (inv_gst_resolve_state(NULL)), NULL);
SELECT inv_assert_text_eq('GstStateCodes.nameFor(96)', (inv_gst_state_name_for('96')), 'Other Country');
SELECT inv_assert_text_eq('GstStateCodes.nameFor(97)', (inv_gst_state_name_for('97')), 'Other Territory');
SELECT inv_assert_text_eq('GstStateCodes.nameFor(99)', (inv_gst_state_name_for('99')), NULL);
