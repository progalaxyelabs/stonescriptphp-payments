UPDATE _inv_diff_results r SET passed = true, expected = r.expected || ' (oracle; accepted divergence)'
  FROM _inv_diff_accepted a WHERE NOT r.passed AND r.label = a.label AND r.actual = a.actual AND r.expected = a.oracle;
SELECT count(*) AS accepted_divergences FROM _inv_diff_results WHERE expected LIKE '%accepted divergence)';

\echo '=== DIFFERENTIAL TALLY (expect failed = 0) ==='
SELECT count(*) AS total, count(*) FILTER (WHERE passed) AS passed, count(*) FILTER (WHERE NOT passed) AS failed FROM _inv_diff_results;
\echo '=== ANY FAILURES BELOW (none expected) ==='
SELECT label, actual, expected FROM _inv_diff_results WHERE NOT passed ORDER BY id;
