\echo '=== TaxEngine compute cases (Lib/TaxEngine.php) ==='
DO $D$ DECLARE r inv_computed_invoice; BEGIN
  r := inv_compute_invoice(ROW('Acme Sellerworks','27AAAAA0000A1Z5','seller','regular','Maharashtra',NULL)::inv_party_input,ROW('Acme Buyer Pvt Ltd',NULL,'buyer',NULL,'Maharashtra',NULL)::inv_party_input,'domestic',NULL,false,false,'INR',NULL,NULL,NULL,'2026-09-11'::timestamptz,ARRAY[ROW('Cloud Workspace','998315','1','1644.65',0.18,'0',false)::inv_line_input]);
  PERFORM inv_assert_eq('H1.taxable', r.taxable_value_minor, 164465);
  PERFORM inv_assert_eq('H1.cgst', r.cgst_minor, 14802);
  PERFORM inv_assert_eq('H1.sgst', r.sgst_minor, 14802);
  PERFORM inv_assert_eq('H1.igst', r.igst_minor, 0);
  PERFORM inv_assert_eq('H1.round_off', r.round_off_minor, NULL::bigint);
  PERFORM inv_assert_eq('H1.gross', r.gross_total_minor, 194069);
  PERFORM inv_assert_text_eq('H1.gross_str', r.gross_total_str, '1940.69');
  PERFORM inv_assert_text_eq('H1.taxable_str', r.taxable_value_str, '1644.65');
  PERFORM inv_assert_text_eq('H1.document_type', r.document_type, 'tax_invoice');
  PERFORM inv_assert_text_eq('H1.document_title', r.document_title, 'Tax Invoice');
  PERFORM inv_assert_text_eq('H1.statutory_legend', r.statutory_legend, NULL);
  PERFORM inv_assert_text_eq('H1.no_itc_note', r.no_itc_note, NULL);
  PERFORM inv_assert_text_eq('H1.tax_treatment', r.tax_treatment, 'intrastate');
  PERFORM inv_assert_text_eq('H1.pos_code', r.place_of_supply_code, '27');
  PERFORM inv_assert_text_eq('H1.pos_name', r.place_of_supply_name, 'Maharashtra');
  PERFORM inv_assert_bool('H1.pos_resolved', r.place_of_supply_resolved, true);
  PERFORM inv_assert_text_eq('H1.currency', r.currency, 'INR');
  PERFORM inv_assert_text_eq('H1.fx_rate', r.fx_rate, NULL);
  PERFORM inv_assert_eq('H1.amount_inr_minor', r.amount_inr_minor, NULL::bigint);
  PERFORM inv_assert_text_eq('H1.invoice_number', r.invoice_number, NULL);
  PERFORM inv_assert_bool('H1.numbered', r.numbered, false);
  PERFORM inv_assert_text_eq('H1.buyer_eff_status', r.buyer_effective_registration_status, 'unregistered');
  PERFORM inv_assert_text_eq('H1.seller_state_code', r.seller_state_code, '27');
  PERFORM inv_assert_text_eq('H1.buyer_state_code', r.buyer_state_code, '27');
  PERFORM inv_assert_eq('H1.L1.taxable', r.lines[1].taxable_value_minor, 164465);
  PERFORM inv_assert_eq('H1.L1.cgst', r.lines[1].cgst_minor, 14802);
  PERFORM inv_assert_eq('H1.L1.sgst', r.lines[1].sgst_minor, 14802);
  PERFORM inv_assert_eq('H1.L1.igst', r.lines[1].igst_minor, 0);
  PERFORM inv_assert_eq('H1.L1.line_total', r.lines[1].line_total_minor, 194069);
  PERFORM inv_assert_eq('H1.L1.qty_milli', r.lines[1].quantity_milli, 1000);
  PERFORM inv_assert_eq('H1.L1.unit_price', r.lines[1].unit_price_minor, 164465);
  PERFORM inv_assert_text_eq('H1.L1.hsn_sac', r.lines[1].hsn_sac, '998315');
  PERFORM inv_assert_text_eq('H1.L1.qty_str', r.lines[1].quantity_str, '1');
  PERFORM inv_assert_text_eq('H1.L1.taxable_str', r.lines[1].taxable_value_str, '1644.65');
  PERFORM inv_assert_text_eq('H1.L1.line_total_str', r.lines[1].line_total_str, '1940.69');
END $D$;
DO $D$ DECLARE r inv_computed_invoice; BEGIN
  r := inv_compute_invoice(ROW('Acme Sellerworks','27AAAAA0000A1Z5','seller','regular','Maharashtra',NULL)::inv_party_input,ROW('Acme Buyer Pvt Ltd',NULL,'buyer',NULL,'Maharashtra',NULL)::inv_party_input,'domestic',NULL,false,false,'INR',NULL,NULL,NULL,'2026-09-11'::timestamptz,ARRAY[ROW('Cloud Workspace','998315','1','12082.40',0.18,'0',false)::inv_line_input]);
  PERFORM inv_assert_eq('H2.taxable', r.taxable_value_minor, 1208240);
  PERFORM inv_assert_eq('H2.cgst', r.cgst_minor, 108742);
  PERFORM inv_assert_eq('H2.sgst', r.sgst_minor, 108742);
  PERFORM inv_assert_eq('H2.igst', r.igst_minor, 0);
  PERFORM inv_assert_eq('H2.round_off', r.round_off_minor, NULL::bigint);
  PERFORM inv_assert_eq('H2.gross', r.gross_total_minor, 1425724);
  PERFORM inv_assert_text_eq('H2.gross_str', r.gross_total_str, '14257.24');
  PERFORM inv_assert_text_eq('H2.taxable_str', r.taxable_value_str, '12082.40');
  PERFORM inv_assert_text_eq('H2.document_type', r.document_type, 'tax_invoice');
  PERFORM inv_assert_text_eq('H2.document_title', r.document_title, 'Tax Invoice');
  PERFORM inv_assert_text_eq('H2.statutory_legend', r.statutory_legend, NULL);
  PERFORM inv_assert_text_eq('H2.no_itc_note', r.no_itc_note, NULL);
  PERFORM inv_assert_text_eq('H2.tax_treatment', r.tax_treatment, 'intrastate');
  PERFORM inv_assert_text_eq('H2.pos_code', r.place_of_supply_code, '27');
  PERFORM inv_assert_text_eq('H2.pos_name', r.place_of_supply_name, 'Maharashtra');
  PERFORM inv_assert_bool('H2.pos_resolved', r.place_of_supply_resolved, true);
  PERFORM inv_assert_text_eq('H2.currency', r.currency, 'INR');
  PERFORM inv_assert_text_eq('H2.fx_rate', r.fx_rate, NULL);
  PERFORM inv_assert_eq('H2.amount_inr_minor', r.amount_inr_minor, NULL::bigint);
  PERFORM inv_assert_text_eq('H2.invoice_number', r.invoice_number, NULL);
  PERFORM inv_assert_bool('H2.numbered', r.numbered, false);
  PERFORM inv_assert_text_eq('H2.buyer_eff_status', r.buyer_effective_registration_status, 'unregistered');
  PERFORM inv_assert_text_eq('H2.seller_state_code', r.seller_state_code, '27');
  PERFORM inv_assert_text_eq('H2.buyer_state_code', r.buyer_state_code, '27');
  PERFORM inv_assert_eq('H2.L1.taxable', r.lines[1].taxable_value_minor, 1208240);
  PERFORM inv_assert_eq('H2.L1.cgst', r.lines[1].cgst_minor, 108742);
  PERFORM inv_assert_eq('H2.L1.sgst', r.lines[1].sgst_minor, 108742);
  PERFORM inv_assert_eq('H2.L1.igst', r.lines[1].igst_minor, 0);
  PERFORM inv_assert_eq('H2.L1.line_total', r.lines[1].line_total_minor, 1425724);
  PERFORM inv_assert_eq('H2.L1.qty_milli', r.lines[1].quantity_milli, 1000);
  PERFORM inv_assert_eq('H2.L1.unit_price', r.lines[1].unit_price_minor, 1208240);
  PERFORM inv_assert_text_eq('H2.L1.hsn_sac', r.lines[1].hsn_sac, '998315');
  PERFORM inv_assert_text_eq('H2.L1.qty_str', r.lines[1].quantity_str, '1');
  PERFORM inv_assert_text_eq('H2.L1.taxable_str', r.lines[1].taxable_value_str, '12082.40');
  PERFORM inv_assert_text_eq('H2.L1.line_total_str', r.lines[1].line_total_str, '14257.24');
END $D$;
DO $D$ DECLARE r inv_computed_invoice; BEGIN
  r := inv_compute_invoice(ROW('Acme Sellerworks','29AAAAA0000A1Z5','seller','regular','Karnataka',NULL)::inv_party_input,ROW('Acme Buyer Pvt Ltd',NULL,'buyer',NULL,'Karnataka',NULL)::inv_party_input,'domestic',NULL,false,false,'INR',NULL,NULL,NULL,'2026-09-11'::timestamptz,ARRAY[ROW('Example Service','998315','1','1000.00',0.18,'0',false)::inv_line_input]);
