-- stonescriptphp-payments :: TEST - entitlement, comp activation, postpaid cycle, legacy bridge (L7.4). STRICT (sets ON_ERROR_STOP itself).
-- Concurrency proofs are in tests/shell/l7_4_entitlement.sh.
--
-- Hand-derived: postpaid plan Rs 499.00 excl. GST 18% intrastate => taxable 49900, GST 8982, gross 58882.
\set ON_ERROR_STOP on
UPDATE inv_gst_config SET config_value = '36500' WHERE config_key IN ('issue_date_window_days_live', 'issue_date_window_days_test');
-- the clock windows are widened for a test that simulates dates (production keeps them tight; see the clock tests below)
UPDATE pay_config SET config_value = '4000000000' WHERE config_key = 'pay_clock_skew_seconds';
UPDATE pay_config SET config_value = '100000000' WHERE config_key = 'ent_late_apply_grace_hours';
\set platform '''l74platform'''
\set t_comp '''00000000-0000-0000-0000-0000000d0001'''
\set t_post '''00000000-0000-0000-0000-0000000d0002'''
\set t_pre  '''00000000-0000-0000-0000-0000000d0003'''
\set t_trial '''00000000-0000-0000-0000-0000000d0004'''
\set t_none '''00000000-0000-0000-0000-0000000d0099'''

CREATE FUNCTION pg_temp.t_assert(p_ok BOOLEAN, p_label TEXT) RETURNS VOID AS $$
BEGIN
    IF p_ok IS NOT TRUE THEN RAISE EXCEPTION 'ASSERTION FAILED: %', p_label; END IF;
    RAISE NOTICE 'ok: %', p_label;
END; $$ LANGUAGE plpgsql;

CREATE FUNCTION pg_temp.t_expect(p_sql TEXT, p_state TEXT, p_label TEXT) RETURNS VOID AS $$
BEGIN
    BEGIN
        EXECUTE p_sql;
    EXCEPTION WHEN OTHERS THEN
        IF SQLSTATE = p_state THEN RAISE NOTICE 'ok: % (raised %)', p_label, p_state; RETURN; END IF;
        RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but got % (%)', p_label, p_state, SQLSTATE, SQLERRM;
    END;
    RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but nothing was raised', p_label, p_state;
END; $$ LANGUAGE plpgsql;

-- the billing run, the way the runner does it: one entitlement per call
CREATE FUNCTION pg_temp.bill(p_as_of TIMESTAMPTZ) RETURNS TABLE (o_entitlement_id BIGINT, o_period_start TIMESTAMPTZ, o_period_end TIMESTAMPTZ, o_invoice_id BIGINT, o_error TEXT) AS $$
DECLARE v_id BIGINT;
BEGIN
    FOR v_id IN SELECT d.o_entitlement_id FROM _ent_billing_due(p_as_of, 100000) d LOOP
        RETURN QUERY SELECT v_id, r.o_period_start, r.o_period_end, r.o_invoice_id, r.o_error FROM _ent_billing_run_one(v_id, p_as_of, 'billing-run') r;
    END LOOP;
END; $$ LANGUAGE plpgsql;
-- the tick in cursor batches of 3 (so batching is exercised), returning how many it changed
CREATE FUNCTION pg_temp.tick(p_as_of TIMESTAMPTZ) RETURNS INTEGER AS $$
DECLARE v RECORD; v_after BIGINT := 0; v_total INTEGER := 0;
BEGIN
    LOOP
        SELECT * INTO v FROM _ent_tick(p_as_of, 3, v_after);
        EXIT WHEN v.o_examined = 0;
        v_total := v_total + v.o_changed; v_after := v.o_last_id;
    END LOOP;
    RETURN v_total;
END; $$ LANGUAGE plpgsql;

CREATE FUNCTION pg_temp.money_state() RETURNS TEXT AS $$
    SELECT (SELECT count(*) FROM inv_invoices)::text || '/' || (SELECT count(*) FROM inv_payments) || '/' || (SELECT count(*) FROM pay_captured_payments)
        || '/' || (SELECT coalesce(sum(last_number), 0) FROM inv_series_counter);
$$ LANGUAGE sql;

