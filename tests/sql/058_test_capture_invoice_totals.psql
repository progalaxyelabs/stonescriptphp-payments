SELECT pg_temp.t_assert((SELECT count(*) = 20 FROM inv_invoices WHERE platform_code = 'l73vec' AND status = 'paid'), 'twenty paid invoices were produced');
SELECT pg_temp.t_assert((SELECT array_agg(number_seq ORDER BY number_seq) = (SELECT array_agg(g::bigint) FROM generate_series(1, 20) g)
                           FROM inv_invoices WHERE platform_code = 'l73vec'), 'and their numbers are exactly 1..20 (the refused gross+1 orders burned none)');

\echo 'ALL L7.3 INVOICE-TOTAL VECTORS PASSED'
