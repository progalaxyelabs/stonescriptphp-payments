INSERT INTO one_time_pricing_plans (id, pricing_plan_id, duration, duration_uom, is_life_time, is_credit_system, credit_quantity, amount, is_amount_tax_exclusive, is_active, created_at, created_by)
VALUES (9101, 9101, NULL, NULL, true, false, NULL, 100, true, true, '2026-01-01', 'seed');

CREATE FUNCTION pg_temp.t_vector(p_idx INT, p_name TEXT, p_state TEXT, p_inclusive BOOLEAN, p_roundoff BOOLEAN, p_lines JSONB,
                                 p_taxable BIGINT, p_cgst BIGINT, p_sgst BIGINT, p_igst BIGINT, p_round_off BIGINT, p_gross BIGINT)
RETURNS VOID AS $$
DECLARE
    v_tenant UUID := ('00000000-0000-0000-0000-00000000c0' || lpad(p_idx::text, 2, '0'))::uuid;
    v_spec   JSONB;
    v_ref    TEXT;
    v_inv    inv_invoices;
    v_out    RECORD;
BEGIN
    v_spec := jsonb_build_object(
        'buyer', jsonb_build_object('legal_name', 'Vector Buyer', 'registration_status', 'unregistered', 'address_state', p_state),
        'billing_country_code', 'IN', 'billing_state', p_state, 'supply_type', 'domestic',
        'price_is_inclusive', p_inclusive, 'round_off', p_roundoff, 'due_days', 0, 'lines', p_lines);

    -- the public quote returns exactly the figures the invoice will carry, and its total is what pay_order_create enforces
    SELECT * INTO v_out FROM pay_order_quote(v_tenant, 'l73vec', 'vec-inv', v_spec::text, 'INR');
    IF (v_out.o_taxable_minor, v_out.o_cgst_minor, v_out.o_sgst_minor, coalesce(v_out.o_igst_minor, 0), coalesce(v_out.o_round_off_minor, 0), v_out.o_gross_minor)
       IS DISTINCT FROM (p_taxable, coalesce(p_cgst, 0), coalesce(p_sgst, 0), coalesce(p_igst, 0), coalesce(p_round_off, 0), p_gross) THEN
        RAISE EXCEPTION 'ASSERTION FAILED: % - quote (% % % % % %) differs from the expected breakdown', p_name,
            v_out.o_taxable_minor, v_out.o_cgst_minor, v_out.o_sgst_minor, v_out.o_igst_minor, v_out.o_round_off_minor, v_out.o_gross_minor;
    END IF;
    IF jsonb_array_length(v_out.o_lines) <> jsonb_array_length(p_lines) OR NOT v_out.o_orderable THEN
        RAISE EXCEPTION 'ASSERTION FAILED: % - quote lines or orderable flag wrong', p_name;
    END IF;

    BEGIN
        PERFORM pay_order_create(v_tenant, 'l73vec', 'vec-' || p_idx || '-bad', 'one_time_license', '9101', NULL,
            p_gross + 1, 'INR', 'razorpay', 'live', 'vec-inv', v_spec::text, 'tester');
        RAISE EXCEPTION 'ASSERTION FAILED: % - an order at gross+1 was accepted', p_name;
    EXCEPTION WHEN SQLSTATE 'PY034' THEN
        NULL;   -- refused, as required
    END;

    SELECT o_order_ref INTO v_ref FROM pay_order_create(v_tenant, 'l73vec', 'vec-' || p_idx, 'one_time_license', '9101', NULL,
        p_gross, 'INR', 'razorpay', 'live', 'vec-inv', v_spec::text, 'tester');
    SELECT * INTO v_out FROM pay_apply_capture('razorpay', 'pay_vec_' || p_idx, v_ref, v_tenant, 'l73vec', p_gross, 'INR', 'live',
        '2026-10-10 10:00+05:30', 'test', p_issued_at => '2026-10-10 10:00+05:30');
    IF v_out.o_outcome <> 'applied' THEN
        RAISE EXCEPTION 'ASSERTION FAILED: % - outcome was %', p_name, v_out.o_outcome;
    END IF;
    SELECT * INTO v_inv FROM inv_invoices WHERE id = v_out.o_invoice_id;
    IF v_inv.taxable_value_minor IS DISTINCT FROM p_taxable OR coalesce(v_inv.cgst_minor, 0) IS DISTINCT FROM p_cgst
       OR coalesce(v_inv.sgst_minor, 0) IS DISTINCT FROM p_sgst OR coalesce(v_inv.igst_minor, 0) IS DISTINCT FROM p_igst
       OR v_inv.round_off_minor IS DISTINCT FROM p_round_off OR v_inv.gross_total_minor IS DISTINCT FROM p_gross
       OR v_inv.status <> 'paid' THEN
        RAISE EXCEPTION 'ASSERTION FAILED: % - got taxable %, cgst %, sgst %, igst %, round_off %, gross % (%), expected %, %, %, %, %, %',
            p_name, v_inv.taxable_value_minor, v_inv.cgst_minor, v_inv.sgst_minor, v_inv.igst_minor, v_inv.round_off_minor,
            v_inv.gross_total_minor, v_inv.status, p_taxable, p_cgst, p_sgst, p_igst, p_round_off, p_gross;
    END IF;
    RAISE NOTICE 'ok: % -> % / % / % / % / % / %', p_name, p_taxable, p_cgst, p_sgst, p_igst, p_round_off, p_gross;
END; $$ LANGUAGE plpgsql;

