-- stonescriptphp-payments :: TEST - capture-first invoice totals against an independent
-- reference (L7.3). STRICT (sets ON_ERROR_STOP itself).
--
-- 20 synthetic captures covering intrastate and interstate supply, tax-exclusive and
-- tax-inclusive prices, decimal quantities, line discounts, several lines and rates (5/12/18/28%),
-- odd GST halves and nearest-rupee round-off. For each: an order is created at the expected gross,
-- the capture is applied through pay_apply_capture, and the invoice that results must carry the
-- expected taxable value, CGST, SGST, IGST, round-off and gross to the paisa. The expected figures
-- were produced by an independent integer re-implementation of the documented GST formulas (half-up
-- at one defined point per line, CGST = half of the line's rounded total tax (half-up) and SGST = the remainder, inclusive prices back-computed), not by
-- the SQL under test. Each order is also created at gross+1 and must be refused (PY034): the quoted
-- amount is proved against the invoice before any money is taken.
--
-- NOT a differential against any platform's historical captures: that needs anonymised legacy
-- data, which this library's tests deliberately never carry.
\set ON_ERROR_STOP on
UPDATE inv_gst_config SET config_value = '36500' WHERE config_key IN ('issue_date_window_days_live', 'issue_date_window_days_test');
UPDATE pay_config SET config_value = '4000000000' WHERE config_key = 'pay_clock_skew_seconds';
UPDATE pay_config SET config_value = '100000000' WHERE config_key = 'ent_late_apply_grace_hours';

CREATE FUNCTION pg_temp.t_assert(p_ok BOOLEAN, p_label TEXT) RETURNS VOID AS $$
BEGIN
    IF p_ok IS NOT TRUE THEN RAISE EXCEPTION 'ASSERTION FAILED: %', p_label; END IF;
    RAISE NOTICE 'ok: %', p_label;
END; $$ LANGUAGE plpgsql;

SELECT _inv_issuer_upsert('vec-issuer', 'l73vec', NULL, 'Vector Seller Pvt Ltd', 'regular', '29AAACX1234C1ZP', '29', 'Bengaluru', false, 'tester');
SELECT _inv_series_create('vec-inv', 'vec-issuer', 'invoice', 'live', 'VC', '/', 6, true, 'tester');
