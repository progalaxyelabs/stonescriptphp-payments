-- stonescriptphp-payments :: TEST - orders, idempotent order creation and the single
-- exactly-once capture path pay_apply_capture (L7.3). STRICT (sets ON_ERROR_STOP itself).
-- The 50-way concurrent redelivery proofs are in tests/shell/l7_3_apply_capture.sh.
--
-- Hand-derived amounts (integer paise), GST 18% intrastate (buyer and seller both Karnataka):
--   subscription  Rs 499.00 excl.  taxable 49900, GST 8982 (CGST 4491 + SGST 4491)  gross 58882
--   licence       Rs 1999.00 excl. taxable 199900, GST 35982 (17991 + 17991)         gross 235882
--   wallet pack   10 credits x Rs 49.00 = 490.00 excl.  taxable 49000, GST 8820      gross 57820
\set ON_ERROR_STOP on
UPDATE inv_gst_config SET config_value = '36500' WHERE config_key IN ('issue_date_window_days_live', 'issue_date_window_days_test');
UPDATE pay_config SET config_value = '4000000000' WHERE config_key = 'pay_clock_skew_seconds';
UPDATE pay_config SET config_value = '100000000' WHERE config_key = 'ent_late_apply_grace_hours';
\set tenant_a '''00000000-0000-0000-0000-0000000b0001'''
\set tenant_b '''00000000-0000-0000-0000-0000000b0002'''
\set platform '''l73platform'''

CREATE FUNCTION pg_temp.t_assert(p_ok BOOLEAN, p_label TEXT) RETURNS VOID AS $$
BEGIN
    IF p_ok IS NOT TRUE THEN RAISE EXCEPTION 'ASSERTION FAILED: %', p_label; END IF;
    RAISE NOTICE 'ok: %', p_label;
END; $$ LANGUAGE plpgsql;

CREATE FUNCTION pg_temp.t_expect(p_sql TEXT, p_state TEXT, p_label TEXT) RETURNS VOID AS $$
BEGIN
    BEGIN
        EXECUTE p_sql;
    EXCEPTION WHEN OTHERS THEN
        IF SQLSTATE = p_state THEN RAISE NOTICE 'ok: % (raised %)', p_label, p_state; RETURN; END IF;
        RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but got % (%)', p_label, p_state, SQLSTATE, SQLERRM;
    END;
    RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but nothing was raised', p_label, p_state;
END; $$ LANGUAGE plpgsql;

CREATE FUNCTION pg_temp.finish_row(p_id BIGINT) RETURNS VOID AS $$
BEGIN
    PERFORM * FROM pay_webhook_claim(p_id);
    PERFORM * FROM pay_webhook_mark(p_id, 'applied');
END; $$ LANGUAGE plpgsql;

-- a NEW capture that disagrees with its order is not raised away: it returns refund_required and is queued as review_mismatch
CREATE FUNCTION pg_temp.t_mismatch(p_sql TEXT, p_txn TEXT, p_label TEXT) RETURNS VOID AS $$
DECLARE v_out TEXT;
BEGIN
    EXECUTE 'SELECT o_outcome FROM ' || regexp_replace(p_sql, '^SELECT \* FROM ', '') || ' x' INTO v_out;
    IF v_out IS DISTINCT FROM 'refund_required' THEN RAISE EXCEPTION 'ASSERTION FAILED: % - outcome was %', p_label, v_out; END IF;
    IF NOT EXISTS (SELECT 1 FROM pay_refund_queue WHERE gateway_txn_ref = p_txn AND reason = 'review_mismatch' AND status = 'open') THEN
        RAISE EXCEPTION 'ASSERTION FAILED: % - no review_mismatch queue entry for %', p_label, p_txn;
    END IF;
    RAISE NOTICE 'ok: % (refund_required + queued)', p_label;
END; $$ LANGUAGE plpgsql;

-- everything the money path can write, as one comparable fingerprint
CREATE FUNCTION pg_temp.t_state() RETURNS TEXT AS $$
    SELECT (SELECT count(*) FROM inv_invoices)::text || '/' || (SELECT count(*) FROM inv_payments) || '/'
        || (SELECT count(*) FROM pay_captured_payments) || '/' || (SELECT count(*) FROM customer_pricing_plans) || '/'
        || (SELECT count(*) FROM wlt_grants) || '/' || (SELECT count(*) FROM pay_events) || '/'
        || (SELECT coalesce(sum(last_number), 0) FROM inv_series_counter) || '/'
        || (SELECT count(*) FROM pay_orders WHERE status = 'paid');
$$ LANGUAGE sql;

