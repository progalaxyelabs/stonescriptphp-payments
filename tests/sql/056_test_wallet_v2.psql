-- stonescriptphp-payments :: TEST - wallet v2 and the double-entry ledger (L7.5). STRICT (sets ON_ERROR_STOP itself).
-- Concurrency proofs (100 concurrent drains, concurrent top-up replay) are in tests/shell/l7_5_wallet.sh.
-- All amounts are milli-credits (1 credit = 1000). Plan: 1 credit = Rs 49.00 = 4900 paise.
\set ON_ERROR_STOP on
UPDATE inv_gst_config SET config_value = '36500' WHERE config_key IN ('issue_date_window_days_live', 'issue_date_window_days_test');
-- simulated dates: widen the clock-skew bound (production keeps it at 300 s; the clock section at the end of this file puts it back)
UPDATE pay_config SET config_value = '4000000000' WHERE config_key = 'pay_clock_skew_seconds';
UPDATE pay_config SET config_value = '100000000' WHERE config_key = 'ent_late_apply_grace_hours';
\set platform '''l75platform'''
\set ta '''00000000-0000-0000-0000-0000000c0001'''
\set tb '''00000000-0000-0000-0000-0000000c0002'''
\set tc '''00000000-0000-0000-0000-0000000c0003'''
\set td '''00000000-0000-0000-0000-0000000c0004'''

CREATE FUNCTION pg_temp.t_assert(p_ok BOOLEAN, p_label TEXT) RETURNS VOID AS $$
BEGIN
    IF p_ok IS NOT TRUE THEN RAISE EXCEPTION 'ASSERTION FAILED: %', p_label; END IF;
    RAISE NOTICE 'ok: %', p_label;
END; $$ LANGUAGE plpgsql;
CREATE FUNCTION pg_temp.t_expect(p_sql TEXT, p_state TEXT, p_label TEXT) RETURNS VOID AS $$
BEGIN
    BEGIN
        EXECUTE p_sql;
    EXCEPTION WHEN OTHERS THEN
        IF SQLSTATE = p_state THEN RAISE NOTICE 'ok: % (raised %)', p_label, p_state; RETURN; END IF;
        RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but got % (%)', p_label, p_state, SQLSTATE, SQLERRM;
    END;
    RAISE EXCEPTION 'ASSERTION FAILED: % - expected % but nothing was raised', p_label, p_state;
END; $$ LANGUAGE plpgsql;
CREATE FUNCTION pg_temp.bal(p_tenant UUID, p_as_of TIMESTAMPTZ) RETURNS BIGINT AS $$
    SELECT o_milli FROM wallet_balance(p_tenant, 'l75platform', p_as_of);
$$ LANGUAGE sql;
-- the sweep, the way the runner does it: due wallets, one transaction-sized call each
CREATE FUNCTION pg_temp.expire(p_as_of TIMESTAMPTZ) RETURNS TABLE (o_wallets INTEGER, o_forfeited_milli BIGINT) AS $$
DECLARE v_id BIGINT;
BEGIN
    o_wallets := 0; o_forfeited_milli := 0;
    FOR v_id IN SELECT d.o_wallet_id FROM _wlt_expire_due(p_as_of, 1000) d LOOP
        o_forfeited_milli := o_forfeited_milli + _wlt_expire_one(v_id, p_as_of);
        o_wallets := o_wallets + 1;
    END LOOP;
    RETURN NEXT;
END; $$ LANGUAGE plpgsql;
CREATE FUNCTION pg_temp.cap(p_txn TEXT, p_amount BIGINT) RETURNS VOID AS $$
    SELECT pay_record_captured_payment('razorpay', p_txn, 'ord_x', p_amount, 'INR', 'success', '2026-10-01 10:00+05:30', 'test', NULL);
$$ LANGUAGE sql;

UPDATE pricing_plans SET is_active = false WHERE is_trial;
INSERT INTO pricing_plans (id, name, is_subscription, is_active, is_trial, created_at, created_by) VALUES (9401, 'Wallet', false, true, false, '2026-01-01', 'seed');
INSERT INTO wlt_packs (id, pricing_plan_id, name, credits_milli, validity_duration, validity_uom, created_by)
VALUES (9401, 9401, 'Ten credits', 10000, 6, 'month', 'seed'), (9402, 9401, 'Two credits', 2000, NULL, NULL, 'seed'), (9403, 9401, 'Five credits', 5000, NULL, NULL, 'seed');

\echo '======== top-up bound to a capture; replay credits once ========'
SELECT pg_temp.t_expect(format($f$SELECT * FROM _wlt_topup(%L, 'l75platform', 9401, 49000, 'razorpay', 'pay_nocapture', '2026-10-01 10:00+05:30', 'test')$f$, :ta), 'PY070',
    'paid credit is never minted without a captured payment');
SELECT pg_temp.cap('pay_w1', 49000);
SELECT o_grant_id AS g1, o_granted_milli AS g1m, o_already AS g1a FROM _wlt_topup(:ta, :platform, 9401, 49000, 'razorpay', 'pay_w1', '2026-10-01 10:00+05:30', 'test') \gset
SELECT pg_temp.t_assert(:g1m = 10000 AND NOT :'g1a'::boolean AND (SELECT expires_at IS NULL FROM wlt_grants WHERE id = :g1), 'Rs 490 buys 10 credits = 10000 milli-credits; with expiry policy OFF (default) the credit never expires, whatever the plan says');
SELECT pg_temp.t_assert((SELECT o_already AND o_grant_id = :g1 FROM _wlt_topup(:ta, :platform, 9401, 49000, 'razorpay', 'pay_w1', '2026-10-01 10:00+05:30', 'test')), 'replaying the capture returns the original grant');
SELECT pg_temp.t_assert((SELECT count(*) = 1 FROM wlt_grants WHERE gateway_txn_ref = 'pay_w1') AND pg_temp.bal(:ta::uuid, '2026-10-02') = 10000, 'and credits exactly once');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _wlt_topup(%L, 'l75platform', 9401, 98000, 'razorpay', 'pay_w1', '2026-10-01 10:00+05:30', 'test')$f$, :ta), 'PY071', 'the same capture with a different amount is refused');
SELECT pg_temp.cap('pay_w2', 3000);
SELECT pg_temp.t_assert((SELECT o_granted_milli = 10000 FROM _wlt_topup(:tb, :platform, 9401, 3000, 'razorpay', 'pay_w2', '2026-10-01 10:00+05:30', 'test')),
    'the credits come from the PACK, not from the amount: a Rs 30 discounted or GST-inclusive payment for the 10-credit pack still grants 10 credits');
SELECT pg_temp.cap('pay_w3', 5000);
UPDATE wlt_packs SET is_active = false WHERE id = 9402;
SELECT pg_temp.t_expect(format($f$SELECT * FROM _wlt_topup(%L, 'l75platform', 9402, 5000, 'razorpay', 'pay_w3', '2026-10-01 10:00+05:30', 'test')$f$, :ta), 'ER015', 'an inactive pack is refused (the capture path queues it, see the capture tests)');
UPDATE wlt_packs SET is_active = true WHERE id = 9402;
SELECT pg_temp.t_expect(format($f$SELECT * FROM _wlt_topup(%L, 'l75platform', 987654, 5000, 'razorpay', 'pay_w3', '2026-10-01 10:00+05:30', 'test')$f$, :ta), 'ER015', 'an unknown pack is refused');
SELECT pg_temp.cap('pay_w4', 6666);
SELECT pg_temp.t_assert((SELECT o_granted_milli = 2000 FROM _wlt_topup(:tb, :platform, 9402, 6666, 'razorpay', 'pay_w4', '2026-10-01 10:00+05:30', 'test')), 'the 2-credit pack grants 2000 milli-credits whatever was paid');
SELECT pg_temp.t_expect($$SELECT _wlt_pack_create(9401, 'Nothing', 0, NULL, NULL, 'seed')$$, 'ER013', 'a pack that grants nothing cannot be created');
SELECT pg_temp.t_expect($$SELECT _wlt_pack_create(987654, 'Orphan', 1000, NULL, NULL, 'seed')$$, 'ER015', 'a pack needs an active pricing plan');
SELECT pg_temp.t_expect($$SELECT _wlt_pack_create(9401, 'Half validity', 1000, 6, NULL, 'seed')$$, 'PY070', 'validity is a pair');
SELECT pg_temp.t_assert((SELECT _wlt_pack_create(9401, 'Annual', 5000, 1, 'year', 'seed')) > 0, 'a valid pack is created');

\echo '======== expiry is a policy switch, default off ========'
UPDATE pay_config SET config_value = '1' WHERE config_key = 'wallet_expiry_enforced';
SELECT pg_temp.cap('pay_w5', 49000);
SELECT pg_temp.t_assert((SELECT o_expires_at = '2027-04-01 10:00+05:30' FROM _wlt_topup(:tb, :platform, 9401, 49000, 'razorpay', 'pay_w5', '2026-10-01 10:00+05:30', 'test')), 'with the switch on, the plan''s 6-month validity applies');
UPDATE pay_config SET config_value = '0' WHERE config_key = 'wallet_expiry_enforced';

\echo '======== drain: FIFO by expiry, milli precision, hard stop, idempotent ========'
SELECT o_outcome FROM _wlt_grant_free(:tc, :platform, 'promo-a', 2000, '2026-10-01 00:00+05:30', '2026-11-01 00:00+05:30', 'admin:asha', 'promo A') \gset
SELECT o_outcome FROM _wlt_grant_free(:tc, :platform, 'promo-b', 3000, '2026-10-01 00:00+05:30', '2026-12-01 00:00+05:30', 'admin:asha', 'promo B') \gset
SELECT pg_temp.cap('pay_w6', 24500);
SELECT * FROM _wlt_topup(:tc, :platform, 9403, 24500, 'razorpay', 'pay_w6', '2026-10-01 00:00+05:30', 'test') \gset t_
SELECT pg_temp.t_assert(pg_temp.bal(:tc::uuid, '2026-10-02') = 10000, 'three grants: 2000 (to 1 Nov) + 3000 (to 1 Dec) + 5000 (never)');
SELECT pg_temp.t_assert((SELECT o_next_expiry_at = '2026-11-01 00:00+05:30' AND o_next_expiry_milli = 2000 AND o_credits = 10 FROM wallet_balance(:tc, :platform, '2026-10-02')), 'balance reports credits and the next expiry');
SELECT o_drain_id AS d1 FROM wallet_drain(:tc, :platform, 'tick-1', 4000, '2026-10-05 00:00+05:30', 'compute', 'meter') \gset
SELECT pg_temp.t_assert((SELECT string_agg(a.milli::text, ',' ORDER BY a.id) = '2000,2000' AND array_agg(g.expires_at ORDER BY a.id) = ARRAY['2026-11-01 00:00+05:30'::timestamptz, '2026-12-01 00:00+05:30'::timestamptz]
                           FROM wlt_drain_allocations a JOIN wlt_grants g ON g.id = a.grant_id WHERE a.drain_id = :d1), 'a drain spanning grants took the EARLIER-expiring first (2000 from A, then 2000 from B)');
SELECT pg_temp.t_assert(pg_temp.bal(:tc::uuid, '2026-10-06') = 6000, 'balance 6000 after the drain');
SELECT pg_temp.t_assert((SELECT o_outcome = 'already_applied' AND o_drain_id = :d1 AND o_balance_milli = 6000 FROM wallet_drain(:tc, :platform, 'tick-1', 4000, '2026-10-05 00:00+05:30', 'compute', 'meter')), 'the same tick id debits once');
SELECT pg_temp.t_expect(format($f$SELECT * FROM wallet_drain(%L, 'l75platform', 'tick-1', 4001, '2026-10-05 00:00+05:30', 'compute', 'meter')$f$, :tc), 'PY071', 'the same tick id with a different amount is refused');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' AND o_balance_milli = 5983 FROM wallet_drain(:tc, :platform, 'tick-2', 17, '2026-10-05 00:01+05:30', 'compute', 'meter')), 'milli precision: 17 milli-credits (0.017 of a credit) debits exactly');
SELECT pg_temp.t_assert((SELECT o_outcome = 'insufficient' AND o_balance_milli = 5983 AND o_debited_milli = 0 FROM wallet_drain(:tc, :platform, 'tick-3', 5984, '2026-10-05 00:02+05:30', 'compute', 'meter')), 'one milli-credit too many: hard stop, nothing written');
SELECT pg_temp.t_assert(NOT EXISTS (SELECT 1 FROM wlt_drains WHERE drain_key = 'tick-3'), 'and no drain row exists for the refused tick');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' AND o_balance_milli = 0 FROM wallet_drain(:tc, :platform, 'tick-4', 5983, '2026-10-05 00:03+05:30', 'compute', 'meter')), 'draining to exactly zero is allowed');
SELECT pg_temp.t_assert((SELECT o_outcome = 'insufficient' AND o_balance_milli = 0 FROM wallet_drain(:tc, :platform, 'tick-5', 1, '2026-10-05 00:04+05:30', 'compute', 'meter')), 'at zero the hard stop holds');

\echo '======== expiry at the exact timestamp; forfeited and reported, not deleted ========'
SELECT o_outcome FROM _wlt_grant_free(:td, :platform, 'exp-1', 5000, '2026-10-01 00:00+05:30', '2026-10-10 12:00+05:30', 'admin:asha', 'expiring promo') \gset
SELECT pg_temp.t_assert(pg_temp.bal(:td::uuid, '2026-10-10 11:59:59+05:30') = 5000, 'one second before expiry it is spendable');
SELECT pg_temp.t_assert(pg_temp.bal(:td::uuid, '2026-10-10 12:00:00+05:30') = 0, 'at the exact expiry instant it is not');
SELECT pg_temp.t_assert((SELECT o_outcome = 'insufficient' AND o_balance_milli = 0 FROM wallet_drain(:td, :platform, 'late-1', 1, '2026-10-10 12:00:00+05:30', 'x', 'meter')), 'a drain at the expiry instant finds nothing to spend');
SELECT pg_temp.t_assert((SELECT o_milli = 5000 AND o_expired_at = '2026-10-10 12:00+05:30' FROM wallet_forfeited(:td, :platform)), 'the unspent credit is reported as forfeited, with when it expired');
SELECT pg_temp.t_assert((SELECT remaining_milli = 0 AND forfeited_milli = 5000 AND granted_milli = 5000 FROM wlt_grants WHERE grant_key = 'free:exp-1'), 'the grant row still exists: forfeited, not deleted');
SELECT pg_temp.t_assert((SELECT o_wallets = 0 FROM pg_temp.expire('2026-10-11')), 'a second sweep finds nothing more');
SELECT o_outcome FROM _wlt_grant_free(:td, :platform, 'exp-2', 700, '2026-10-01 00:00+05:30', '2026-10-12 00:00+05:30', 'admin:asha', 'second') \gset
SELECT pg_temp.t_assert((SELECT o_wallets = 1 AND o_forfeited_milli = 700 FROM pg_temp.expire('2026-10-13')), 'the sweep forfeits expired credit without waiting for a drain');
SELECT pg_temp.t_expect(format($f$UPDATE wlt_grants SET remaining_milli = 99 WHERE grant_key = 'free:exp-2'$f$), 'PY073', 'credit cannot be put back');
SELECT pg_temp.t_expect($$DELETE FROM wlt_grants$$, 'PY073', 'grants are never deleted');

\echo '======== free grants: idempotent, audited ========'
SELECT pg_temp.t_assert((SELECT o_outcome = 'already_applied' FROM _wlt_grant_free(:td, :platform, 'exp-1', 5000, '2026-10-01 00:00+05:30', '2026-10-10 12:00+05:30', 'admin:asha', 'again')), 'a replayed grant key credits nothing');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _wlt_grant_free(%L, 'l75platform', 'exp-1', 9999, '2026-10-01 00:00+05:30', NULL, 'admin:asha', 'x')$f$, :td), 'PY071', 'the same key with a different amount is refused');
SELECT pg_temp.t_expect(format($f$SELECT * FROM _wlt_grant_free(%L, 'l75platform', 'k', 5, '2026-10-01', NULL, '', 'x')$f$, :td), 'PY070', 'actor is required');

\echo '======== the ledger ========'
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _ledger_verify()), '_ledger_verify reports nothing after all of the above');
SELECT pg_temp.t_assert((SELECT bool_and(s = 0) FROM (SELECT sum(amount_milli) s FROM ledger_entries GROUP BY txn_id) x), 'every posting sums to zero');
SELECT pg_temp.t_expect($$SELECT _ledger_post('drain', 'bad', now(), '[{"account":"a","amount_milli":5},{"account":"b","amount_milli":-4}]'::jsonb)$$, 'PY072', 'an unbalanced posting is refused');
SELECT pg_temp.t_expect($q$DO $x$ BEGIN
        INSERT INTO ledger_txns (kind, ref, at) VALUES ('drain', 'sneak', now());
        INSERT INTO ledger_entries (txn_id, account, amount_milli) SELECT max(id), 'wallet:1', 7 FROM ledger_txns;
        SET CONSTRAINTS ALL IMMEDIATE;
      END $x$$q$, 'PY072', 'a direct unbalanced INSERT is refused at commit (deferred constraint)');
SELECT pg_temp.t_expect($$UPDATE ledger_entries SET amount_milli = 1$$, 'PY073', 'ledger entries are immutable');
SELECT pg_temp.t_expect($$DELETE FROM ledger_txns$$, 'PY073', 'ledger postings are never deleted');
SELECT pg_temp.t_expect('TRUNCATE ledger_entries CASCADE', 'PY019', 'the ledger cannot be truncated');
-- the verifier does catch corruption (done with the guard disabled, then undone)
ALTER TABLE wlt_grants DISABLE TRIGGER wlt_grants_guard;
UPDATE wlt_grants SET remaining_milli = remaining_milli - 1 WHERE grant_key = 'cap:razorpay:pay_w5';
SELECT pg_temp.t_assert((SELECT count(*) >= 1 AND bool_or(o_check = 'wallet_balance') AND bool_or(o_check = 'grant_parts') FROM _ledger_verify()), '_ledger_verify catches a grant changed behind the ledger''s back');
UPDATE wlt_grants SET remaining_milli = remaining_milli + 1 WHERE grant_key = 'cap:razorpay:pay_w5';
ALTER TABLE wlt_grants ENABLE TRIGGER wlt_grants_guard;
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _ledger_verify()), 'and is clean again once restored');

\echo '======== opening balances from a legacy table reconcile to the last milli-credit ========'
CREATE TABLE legacy_wallets (tenant_id TEXT, platform_code TEXT, credits TEXT);
INSERT INTO legacy_wallets VALUES
    ('00000000-0000-0000-0000-0000000c1001', 'l75platform', '12.5'), ('00000000-0000-0000-0000-0000000c1002', 'l75platform', '100'),
    ('00000000-0000-0000-0000-0000000c1003', 'l75platform', '0.001'), ('00000000-0000-0000-0000-0000000c1004', 'l75platform', '0.0005'),
    ('00000000-0000-0000-0000-0000000c1005', 'l75platform', '-3'), ('not-a-uuid', 'l75platform', '5'), ('00000000-0000-0000-0000-0000000c1006', 'l75platform', '7.125');
SELECT * FROM _wlt_import_opening_balances((SELECT jsonb_agg(to_jsonb(l)) FROM legacy_wallets l), 1000, 'migration-script', '2026-10-10') \gset imp_
SELECT pg_temp.t_assert(:imp_o_imported = 4 AND :imp_o_rejected = 3 AND :imp_o_already = 0, 'four wallets imported; the sub-milli, negative and non-UUID rows rejected (never rounded)');
SELECT pg_temp.t_assert(:imp_o_total_milli = (12500 + 100000 + 1 + 7125) AND
                        (SELECT sum(o_milli) FROM wlt_wallets w, LATERAL wallet_balance(w.tenant_id, w.platform_code, '2026-10-11') WHERE w.tenant_id::text LIKE '00000000-0000-0000-0000-0000000c100%') = 119626,
    'the imported total and the wallets'' balances equal the legacy sum x scale exactly (119.626 credits)');
SELECT pg_temp.t_assert((SELECT o_imported = 0 AND o_already = 4 FROM _wlt_import_opening_balances((SELECT jsonb_agg(to_jsonb(l)) FROM legacy_wallets l), 1000, 'migration-script', '2026-10-10')), 'the import is idempotent');
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _ledger_verify()), 'the books still balance');

\echo '======== 10,000 random operations, then the books must balance ========'
CREATE TABLE rnd_log (op TEXT, n BIGINT);
DO $r$
DECLARE
    i INT; w UUID; t TIMESTAMPTZ := '2027-01-01 00:00+00'; x DOUBLE PRECISION; m BIGINT; k TEXT; res RECORD;
    keys TEXT[] := '{}'; kms BIGINT[] := '{}'; kw UUID[] := '{}'; idx INT; drained BIGINT := 0; granted BIGINT := 0; replays INT := 0; refused INT := 0; tops INT := 0; wallets UUID[];
BEGIN
    FOR i IN 1..5 LOOP wallets := array_append(wallets, ('00000000-0000-0000-0000-0000000d00' || lpad(i::text, 2, '0'))::uuid); END LOOP;
    FOR i IN 1..10000 LOOP
        w := wallets[1 + floor(random() * 5)::int];
        t := t + make_interval(secs => floor(random() * 7200)::int);
        x := random();
        IF x < 0.55 THEN
            IF random() < 0.15 AND array_length(keys, 1) > 0 THEN                    -- replay an old tick
                idx := 1 + floor(random() * array_length(keys, 1))::int;
                SELECT * INTO res FROM wallet_drain(kw[idx], 'l75platform', keys[idx], kms[idx], t, 'rnd', 'rnd');
                IF res.o_outcome <> 'already_applied' THEN RAISE EXCEPTION 'replayed tick % was % (expected already_applied)', keys[idx], res.o_outcome; END IF;
                replays := replays + 1;
            ELSE
                m := 1 + floor(random() * 4000)::bigint; k := 'rk' || i;
                SELECT * INTO res FROM wallet_drain(w, 'l75platform', k, m, t, 'rnd', 'rnd');
                IF res.o_outcome = 'applied' THEN
                    drained := drained + m; keys := array_append(keys, k); kms := array_append(kms, m); kw := array_append(kw, w);
                    IF res.o_balance_milli < 0 THEN RAISE EXCEPTION 'overdrawn at op %', i; END IF;
                ELSE refused := refused + 1; END IF;
            END IF;
        ELSIF x < 0.80 THEN
            m := 500 + floor(random() * 5000)::bigint;
            PERFORM _wlt_grant_free(w, 'l75platform', 'rg' || i, m, t, CASE WHEN random() < 0.5 THEN t + make_interval(hours => 1 + floor(random() * 200)::int) END, 'rnd', 'rnd');
            granted := granted + m;
        ELSIF x < 0.90 THEN
            m := 3333 * (1 + floor(random() * 3)::int);
            PERFORM pay_record_captured_payment('razorpay', 'pay_rnd' || i, 'ord_x', m, 'INR', 'success', t, 'rnd', NULL);
            PERFORM _wlt_topup(w, 'l75platform', 9402, m, 'razorpay', 'pay_rnd' || i, t, 'rnd');
            tops := tops + 1;
        ELSIF x < 0.95 THEN
            PERFORM pg_temp.expire(t);
        ELSE
            PERFORM wallet_balance(w, 'l75platform', t);
        END IF;
    END LOOP;
    INSERT INTO rnd_log VALUES ('drained', drained), ('granted_free', granted), ('replays', replays), ('refused', refused), ('topups', tops);
END $r$;
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _ledger_verify()), '_ledger_verify is ZERO after 10,000 random operations');
SELECT pg_temp.t_assert((SELECT n FROM rnd_log WHERE op = 'drained') = (SELECT coalesce(sum(debited_milli), 0) FROM wlt_drains d JOIN wlt_wallets w ON w.id = d.wallet_id WHERE w.tenant_id::text LIKE '00000000-0000-0000-0000-0000000d00%'),
    'the drains recorded equal the drains the model accepted');
SELECT pg_temp.t_assert((SELECT n FROM rnd_log WHERE op = 'replays') > 100 AND (SELECT n FROM rnd_log WHERE op = 'refused') > 0 AND (SELECT n FROM rnd_log WHERE op = 'topups') > 500, 'the run really exercised replays, the hard stop and top-ups');
SELECT pg_temp.t_assert((SELECT sum(granted_milli) = sum(remaining_milli) + sum(forfeited_milli) + (SELECT coalesce(sum(milli), 0) FROM wlt_drain_allocations) FROM wlt_grants),
    'conservation: everything granted is either still held, forfeited, or consumed');
SELECT pg_temp.t_assert((SELECT bool_and(remaining_milli >= 0) FROM wlt_grants), 'no grant is overdrawn');

\echo '======== opening balances: a changed legacy balance is counted, and the reconciliation gate catches drift ========'
SELECT pg_temp.t_assert((SELECT o_changed = 0 AND o_already = 4 FROM _wlt_import_opening_balances((SELECT jsonb_agg(to_jsonb(l)) FROM legacy_wallets l), 1000, 'migration-script', '2026-10-10')), 'an unchanged re-import: nothing changed');
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _wlt_verify_opening((SELECT jsonb_agg(to_jsonb(l)) FROM legacy_wallets l WHERE tenant_id <> 'not-a-uuid' AND credits IN ('12.5','100','0.001','7.125')), 1000, '2026-10-11')),
    'the reconciliation gate: legacy balances equal the wallets to the last milli-credit');
UPDATE legacy_wallets SET credits = '13.5' WHERE tenant_id = '00000000-0000-0000-0000-0000000c1001';
SELECT pg_temp.t_assert((SELECT o_changed = 1 AND o_imported = 0 FROM _wlt_import_opening_balances((SELECT jsonb_agg(to_jsonb(l)) FROM legacy_wallets l), 1000, 'migration-script', '2026-10-10')),
    'a legacy balance that moved after the first import is COUNTED as changed (and not silently rewritten)');
SELECT pg_temp.t_assert((SELECT count(*) = 1 AND max(o_note) = 'balance differs' AND max(o_actual_milli) = 12500 AND max(o_expected_milli) = 13500
                           FROM _wlt_verify_opening((SELECT jsonb_agg(to_jsonb(l)) FROM legacy_wallets l WHERE credits IN ('13.5','100','0.001','7.125')), 1000, '2026-10-11')),
    'and the gate reports exactly that wallet');
SELECT pg_temp.t_assert((SELECT o_note = 'no wallet' FROM _wlt_verify_opening('[{"tenant_id":"00000000-0000-0000-0000-0000000c1999","platform_code":"l75platform","credits":"5"}]', 1000, '2026-10-11')), 'a legacy wallet with no wallet in the library is reported');

\echo '======== metering without drift: wallet_drain_cumulative ========'
SELECT _wlt_grant_free('00000000-0000-0000-0000-0000000c5001', :platform, 'meter-fund', 100000000, '2026-10-01', NULL, 'admin:asha', 'meter test funding');
CREATE TEMP TABLE meter_log (tick INT, cum NUMERIC, delta BIGINT);
DO $m$
DECLARE
    i INT; v_cum NUMERIC := 0; r RECORD; naive BIGINT := 0; prev_target BIGINT := 0;
BEGIN
    FOR i IN 1..720 LOOP
        v_cum := v_cum + round((random() * 1.9 + 0.001)::numeric, 6);                 -- fractional minutes of compute
        SELECT * INTO r FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-' || i, v_cum, 17, 60, '2026-10-05 00:00+05:30', 'compute', 'meter');
        IF r.o_outcome <> 'applied' THEN RAISE EXCEPTION 'tick % was %', i, r.o_outcome; END IF;
        INSERT INTO meter_log VALUES (i, v_cum, r.o_debited_milli);
        naive := naive + round((v_cum - (SELECT coalesce(max(cum), 0) FROM meter_log WHERE tick < i)) * 17 / 60)::bigint;      -- what rounding each tick would have charged
        IF i % 7 = 0 THEN                                                           -- replay an old tick: must change nothing
            SELECT * INTO r FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-' || (i - 3), (SELECT cum FROM meter_log WHERE tick = i - 3), 17, 60, '2026-10-05 00:00+05:30', 'compute', 'meter');
            IF r.o_outcome <> 'already_applied' THEN RAISE EXCEPTION 'replayed tick was %', r.o_outcome; END IF;
        END IF;
    END LOOP;
    INSERT INTO rnd_log VALUES ('naive_per_tick_rounding', naive);
END $m$;
SELECT pg_temp.t_assert((SELECT count(*) = 720 FROM meter_log), '720 fractional per-minute ticks were metered');
SELECT pg_temp.t_assert((SELECT sum(delta) FROM meter_log) = div((SELECT max(cum) FROM meter_log) * 17, 60::numeric)::bigint
                    AND (SELECT debited_milli FROM wlt_meters WHERE meter_key = 'vm-1') = (SELECT sum(delta) FROM meter_log),
    'the total debited is EXACTLY floor(total usage x rate), to the milli-credit');
SELECT pg_temp.t_assert((SELECT n FROM rnd_log WHERE op = 'naive_per_tick_rounding') <> (SELECT sum(delta) FROM meter_log), 'while rounding each tick would have drifted away from it');
SELECT pg_temp.t_assert((SELECT sum(debited_milli) = (SELECT sum(delta) FROM meter_log) FROM wlt_drains d JOIN wlt_wallets w ON w.id = d.wallet_id WHERE w.tenant_id = '00000000-0000-0000-0000-0000000c5001'),
    'and the drains on the wallet agree');
SELECT pg_temp.t_assert((SELECT o_outcome = 'superseded' AND o_debited_milli = 0 FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-late', 1, 17, 60, '2026-10-05 00:00+05:30', 'c', 'm')),
    'an OLDER cumulative under a new tick key (out-of-order delivery) is a no-op: superseded, charges nothing');
SELECT pg_temp.t_assert((SELECT superseded AND delta_milli = 0 FROM wlt_meter_ticks WHERE tick_key = 'tick-late')
                    AND (SELECT o_outcome = 'superseded' FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-late', 1, 17, 60, '2026-10-05 00:00+05:30', 'c', 'm')),
    'it is recorded as superseded for the audit, and its own replay answers the same');
SELECT pg_temp.t_assert((SELECT debited_milli = (SELECT sum(delta) FROM meter_log) FROM wlt_meters WHERE meter_key = 'vm-1'), 'and the meter total did not move');
SELECT pg_temp.t_expect($$SELECT * FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-1', 999, 17, 60, '2026-10-05 00:00+05:30', 'c', 'm')$$, 'PY071', 'a tick key cannot be reused for another cumulative');
SELECT pg_temp.t_expect($$SELECT * FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-rate', 99999, 18, 60, '2026-10-05 00:00+05:30', 'c', 'm')$$, 'PY071', 'a meter''s rate cannot change (use a new meter for a new rate)');
-- retiring a meter: a reset or a rate change starts a NEW meter key
SELECT pg_temp.t_assert(_wlt_meter_close('00000000-0000-0000-0000-0000000c5001', :platform, 'vm-1', 'ops') AND NOT _wlt_meter_close('00000000-0000-0000-0000-0000000c5001', :platform, 'vm-1', 'ops'), 'closing a meter works once');
SELECT pg_temp.t_expect($$SELECT * FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-after-close', 99999, 17, 60, '2026-10-05 00:00+05:30', 'c', 'm')$$, 'PY071', 'a closed meter refuses new ticks');
SELECT pg_temp.t_assert((SELECT o_outcome = 'already_applied' FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1', 'tick-1', (SELECT cum FROM meter_log WHERE tick = 1), 17, 60, '2026-10-05 00:00+05:30', 'c', 'm')), 'but ticks it already recorded stay idempotent');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' AND o_debited_milli = 1 FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5001', 'l75platform', 'vm-1-gen2', 't1', 7, 17, 60, '2026-10-05 00:00+05:30', 'c', 'm')),
    'a reset resource continues on a NEW meter key, from its own zero (floor(7 x 17/60) = 1)');
-- insufficient: the meter does not advance, and the next tick asks for the whole shortfall
SELECT _wlt_grant_free('00000000-0000-0000-0000-0000000c5002', :platform, 'tiny', 10, '2026-10-01', NULL, 'admin:asha', 'tiny');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' AND o_debited_milli = 8 AND o_balance_milli = 2 FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5002', :platform, 'm', 't1', 24, 1, 3, '2026-10-05', 'c', 'x')), '24 units at 1/3 milli = 8 of the 10 milli-credits');
SELECT pg_temp.t_assert((SELECT o_outcome = 'insufficient' AND o_debited_milli = 0 AND o_total_debited_milli = 8 FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5002', :platform, 'm', 't2', 60, 1, 3, '2026-10-05', 'c', 'x')),
    'a tick that cannot be paid answers insufficient and writes nothing');
SELECT _wlt_grant_free('00000000-0000-0000-0000-0000000c5002', :platform, 'top', 1000, '2026-10-01', NULL, 'admin:asha', 'topup');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' AND o_debited_milli = 12 AND o_total_debited_milli = 20 FROM wallet_drain_cumulative('00000000-0000-0000-0000-0000000c5002', :platform, 'm', 't3', 60, 1, 3, '2026-10-05', 'c', 'x')),
    'after funding, the next tick collects the WHOLE shortfall (usage is never forgiven or double-charged)');

\echo '======== guards: wallets, grants, the unit, the v1 mint path, ledger kinds ========'
SELECT pg_temp.t_expect($$UPDATE wlt_wallets SET tenant_id = '00000000-0000-0000-0000-0000000c9999'$$, 'PY073', 'a wallet never changes tenant');
SELECT pg_temp.t_expect($$UPDATE wlt_grants SET gateway_code = 'x' WHERE source = 'topup'$$, 'PY073', 'a grant''s gateway cannot be rewritten');
SELECT pg_temp.t_expect($$UPDATE wlt_grants SET created_by = 'someone-else'$$, 'PY073', 'nor its author');
SELECT pg_temp.t_expect($$UPDATE wlt_grants SET unit_price_pinned = 1$$, 'PY073', 'nor its pinned price');
SELECT pg_temp.t_expect($$UPDATE pay_config SET config_value = '100' WHERE config_key = 'wallet_milli_per_credit'$$, 'PY073', 'the milli-credit unit cannot change once any credit exists');
SELECT pg_temp.t_expect($$DELETE FROM pay_config WHERE config_key = 'wallet_milli_per_credit'$$, 'PY073', 'nor be deleted');
SELECT count(*) FROM _pay_ensure_reference_data();
SELECT _wlt_mark_platform_migrated('migplat', 'admin:asha');
SELECT pg_temp.t_expect($$SELECT * FROM grant_free_credits('00000000-0000-0000-0000-0000000c7001', 'migplat', 5, now(), NULL, 'x')$$, 'PY074', 'v1 free credits are refused for a migrated platform');
SELECT pg_temp.t_expect($$SELECT * FROM topup_wallet('00000000-0000-0000-0000-0000000c7001', 'migplat', 1, 4900, now(), 'x')$$, 'PY074', 'v1 top-up too');
SELECT pg_temp.t_expect($$SELECT * FROM record_wallet_drain('00000000-0000-0000-0000-0000000c7001', 'migplat', 1, 'sku', now(), 1, 'x')$$, 'PY074', 'and the v1 drain');
SELECT pg_temp.t_assert((SELECT granted_credits = 5 FROM grant_free_credits('00000000-0000-0000-0000-0000000c7002', 'notmigrated', 5, now(), NULL, 'x')), 'an unmigrated platform keeps using v1');
SELECT pg_temp.t_assert(_ledger_post('refund', 'r1', now(), '[{"account":"wallet:1","amount_milli":-5},{"account":"sink:refund","amount_milli":5}]'::jsonb) > 0
                    AND _ledger_post('reversal', 'r2', now(), '[{"account":"wallet:1","amount_milli":5},{"account":"sink:refund","amount_milli":-5}]'::jsonb) > 0
                    AND _ledger_post('clawback', 'r3', now(), '[{"account":"wallet:1","amount_milli":-1},{"account":"sink:clawback","amount_milli":1}]'::jsonb) > 0, 'refund, reversal and clawback postings exist for L7.6');
SELECT pg_temp.t_expect($$SELECT _ledger_post('bogus', 'r4', now(), '[{"account":"a","amount_milli":1},{"account":"b","amount_milli":-1}]'::jsonb)$$, '23514', 'but only the declared kinds');

\echo '======== the clock: future dates are clamped, backdating before a sweep is documented behaviour ========'
UPDATE pay_config SET config_value = '300' WHERE config_key = 'pay_clock_skew_seconds';
SELECT _wlt_grant_free('00000000-0000-0000-0000-0000000c6001', :platform, 'clock-1', 5000, now() + interval '1 day', now() + interval '2 days', 'admin:asha', 'dated tomorrow');
SELECT pg_temp.t_assert((SELECT granted_at <= now() FROM wlt_grants WHERE grant_key = 'free:clock-1'), 'granted_at = least(given, now()): credit cannot appear before it exists');
SELECT pg_temp.t_assert((SELECT o_outcome = 'applied' FROM wallet_drain('00000000-0000-0000-0000-0000000c6001', :platform, 'clock-d1', 100, now() + interval '30 days', 'x', 'm')), 'a drain dated 30 days ahead is accepted ...');
SELECT pg_temp.t_assert((SELECT usage_at <= now() + interval '301 seconds' FROM wlt_drains WHERE drain_key = 'clock-d1'), '... but its usage time was clamped to now + skew (so it cannot spend credit that would have expired, nor forfeit early)');
SELECT pg_temp.t_assert((SELECT count(*) = 0 FROM _wlt_expire_due(now() + interval '30 days', 100) d WHERE d.o_wallet_id = (SELECT id FROM wlt_wallets WHERE tenant_id = '00000000-0000-0000-0000-0000000c6001')),
    'a sweep dated in the future finds nothing due: it cannot forfeit credit early');
SELECT pg_temp.t_assert((SELECT o_forfeited_milli = 0 FROM pg_temp.expire(now() + interval '30 days')) AND (SELECT remaining_milli > 0 FROM wlt_grants WHERE grant_key = 'free:clock-1'), 'and a future-dated sweep forfeited nothing');
SELECT pg_temp.t_expect($$SELECT * FROM _wlt_grant_free('00000000-0000-0000-0000-0000000c6001', 'l75platform', 'clock-2', 5, now(), now() - interval '1 day', 'admin:asha', 'bad expiry')$$, 'PY070', 'an expiry before the grant is refused');

\echo 'ALL L7.5 SQL ASSERTIONS PASSED'
